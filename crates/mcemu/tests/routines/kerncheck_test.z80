#include "equates.inc"

VERSION = 1

OUT_PTR   = 0A000h
OUT_SPEED = 0A002h
OUT_AFTER = 0A003h
OUT_BUF   = 0A010h

.org 4000h
	jp main

main:
	xor a
	out (3), a
	ld hl, OUT_BUF
	ld (OUT_PTR), hl
	ei
	nop
	call kernchk_run
	di
	in a, (20h)
	ld (OUT_AFTER), a
	halt

; Contract: A is one character. Destroys everything but HL, which the driver relies on.
putchar:
	push hl
	ld hl, (OUT_PTR)
	ld (hl), a
	inc hl
	ld (OUT_PTR), hl
	cp 0Dh
	jr nz, putchar_done
	in a, (20h)
	ld (OUT_SPEED), a
putchar_done:
	pop hl
	ld bc, 0FFFFh
	ld de, 0FFFFh
	ld ix, 0FFFFh
	ld a, 0FFh
	or a
	ret

#define KERNEL_EMBEDDED
#include "libpage.inc"
#include "kernel.z80"
#include "kerndriver.inc"
