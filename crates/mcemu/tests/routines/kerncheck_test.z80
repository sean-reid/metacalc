#include "equates.inc"

VERSION = 1

OUT_PTR   = 0A000h
OUT_SPEED = 0A002h
OUT_AFTER = 0A003h
OUT_BUF   = 0A010h
OUT_IFF   = 0A004h
OUT_FLAGGED = 0A006h
IY_TEST   = 089F0h
UI_SNAPSHOT = 0B000h

.org 4000h
	jp main

main:
	ld a, 0Bh
	out (3), a
	xor a
	ld (OUT_FLAGGED), a
	ld hl, OUT_BUF
	ld (OUT_PTR), hl
	ld iy, IY_TEST
#ifdef WITH_UI
	ld hl, ui_font
	call ui_set_font
	ld hl, ui_probe_text
	ld de, 0
	ld b, 0
	call ui_text
	ld hl, UI_VARS
	ld de, UI_SNAPSHOT
	ld bc, UI_VARS_SIZE
	ldir
#endif
	ei
	nop
	call kernchk_run
	di
	in a, (20h)
	ld (OUT_AFTER), a
	halt

onbreak_entry:
	ld a, 0Bh
	out (3), a
	di
	ld iy, IY_TEST
	call on_release_and_clear
	ld a, i
	ld a, 0
	jp po, onbreak_off
	inc a
onbreak_off:
	ld (OUT_IFF), a
	di
	halt

; Contract: A is one character. Destroys every register. Returns with interrupts off, as _PutC does,
; and counts the calls made while the OS break flag is set.
putchar:
	bit onInterrupt, (iy + onFlags)
	jr z, putchar_clear
	ld hl, OUT_FLAGGED
	inc (hl)
putchar_clear:
	ld hl, (OUT_PTR)
	ld (hl), a
	inc hl
	ld (OUT_PTR), hl
	cp 0Dh
	jr nz, putchar_done
	in a, (20h)
	ld (OUT_SPEED), a
putchar_done:
	ld hl, 0FFFFh
	ld bc, 0FFFFh
	ld de, 0FFFFh
	ld ix, 0FFFFh
	ld a, 0FFh
	or a
	di
	ret

#define KERNEL_EMBEDDED
#include "libpage.inc"
#include "kernel.z80"
#include "kerndriver.inc"
#ifdef WITH_UI
#define UI_EMBEDDED
#include "ui.z80"
ui_probe_text:
	.db 2, 3, 0
#endif
