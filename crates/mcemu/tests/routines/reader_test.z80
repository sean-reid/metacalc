#define LIB_EMBEDDED
#ifdef WITH_KERNEL
#define KERNEL_EMBEDDED
#endif

TEST_TARGET	.equ $A000
TEST_SP		.equ $A002
TEST_EI		.equ $A004
IN_A		.equ $A005
IN_BC		.equ $A006
IN_DE		.equ $A008
IN_HL		.equ $A00A
IN_IX		.equ $A00C
IN_IY		.equ $A00E
OUT_AF		.equ $A010
OUT_BC		.equ $A012
OUT_DE		.equ $A014
OUT_HL		.equ $A016
OUT_IX		.equ $A018
OUT_IY		.equ $A01A
OUT_IFF		.equ $A01C
OUT_P5		.equ $A01D
OUT_P7		.equ $A01E
TEST_BUF	.equ $A100
TEST_MASK	.equ $A01F
NODE_COUNT	.equ $A020
NODE_PTR	.equ $A022
NODES		.equ $AC00
IRQ_COUNT	.equ $A5F0
IRQ_HANDLER	.equ $A600

.org $4000
	jp call_entry

call_entry:
	ld a,(TEST_MASK)
	out (3),a
	ld sp,(TEST_SP)
	ld hl,call_done
	push hl
	ld hl,(TEST_TARGET)
	push hl
	ld a,(TEST_EI)
	or a
	jr z,call_load
	ei
call_load:
	ld ix,(IN_IX)
	ld iy,(IN_IY)
	ld hl,(IN_HL)
	ld de,(IN_DE)
	ld bc,(IN_BC)
	ld a,(IN_A)
	ret

call_nop:
	ret

; Runs lib_node over the bytes at HL, C of them, and lists the nodes at NODES as kind, value (2).
call_walk:
	push hl
	ld hl,NODES
	ld (NODE_PTR),hl
	xor a
	ld (NODE_COUNT),a
	pop hl
walk_loop:
	ld a,c
	or a
	jr z,walk_done
	call lib_node
	ret nz
	push hl
	ld hl,(NODE_PTR)
	ld (hl),b
	inc hl
	ld (hl),e
	inc hl
	ld (hl),d
	inc hl
	ld (NODE_PTR),hl
	ld hl,NODE_COUNT
	inc (hl)
	pop hl
	jr walk_loop
walk_done:
	xor a
	ret

; Runs from RAM at IRQ_HANDLER: acknowledges the interrupt by writing port 3 as zero and then again,
; counts it, and leaves the shadow registers holding junk. It does not scan the keys.
irq_body_start:
	push af
	in a,(3)
	push af
	xor a
	out (3),a
	pop af
	out (3),a
	ld a,(IRQ_COUNT)
	inc a
	ld (IRQ_COUNT),a
	exx
	ld bc,$BAD0
	ld de,$BAD1
	ld hl,$BAD2
	exx
	ex af,af'
	ld a,$A5
	ex af,af'
	pop af
	ei
	reti
irq_body_end:

call_done:
	ld (OUT_HL),hl
	ld (OUT_DE),de
	ld (OUT_BC),bc
	ld (OUT_IX),ix
	ld (OUT_IY),iy
	push af
	pop hl
	ld (OUT_AF),hl
	ld a,i
	ld a,0
	jp po,call_iff_off
	inc a
call_iff_off:
	ld (OUT_IFF),a
	in a,(5)
	ld (OUT_P5),a
	in a,(7)
	ld (OUT_P7),a
	di
	halt

#ifdef WITH_KERNEL
#include "kernel.z80"
#endif
#include "font.inc"
#include "lib/lib.z80"
