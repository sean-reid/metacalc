#include "equates.inc"

#ifndef MODE
#define MODE 05h
#endif

; Calls SERVICE with the LCD on in increment mode MODE, 05h unless defined, and records the status
; byte, busy bit cleared, before at RESULT and after at RESULT + 1.
.org ENTRY
	ld a, 03h
	out (10h), a
	call settle
	ld a, MODE
	out (10h), a
	call settle
	in a, (10h)
	and 7Fh
	ld (RESULT), a
	bcall(SERVICE)
	call settle
	in a, (10h)
	and 7Fh
	ld (RESULT + 1), a
	di
	halt
settle:
	ld b, 20
settle_wait:
	djnz settle_wait
	ret
