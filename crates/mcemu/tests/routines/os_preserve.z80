#include "equates.inc"

.org ENTRY
	ld hl, 0
	add hl, sp
	ld (RESULT + 10), hl
	exx
	ld bc, 1111h
	ld de, 2222h
	ld hl, 3333h
	exx
	ld bc, 1234h
	ld de, 5678h
	ld hl, 9ABCh
	ld ix, 0DEF0h
	bcall(_GetCSC)
	ld (RESULT), bc
	ld (RESULT + 2), de
	ld (RESULT + 4), hl
	ld (RESULT + 6), ix
	ld hl, 0
	add hl, sp
	ld (RESULT + 8), hl
	exx
	ld (RESULT + 12), bc
	ld (RESULT + 14), de
	ld (RESULT + 16), hl
	exx
	halt
