#define KERNEL_EMBEDDED

#ifndef KERNEL_RAM
#define KERNEL_RAM $C000
#endif

TEST_INIT_STATUS	.equ $FF00
TEST_VERIFY_STATUS	.equ $FF01
TEST_ASSERTION		.equ $FF02
TEST_COUNT		.equ $FF04
TEST_IFF		.equ $FF06
TEST_BLOCK		.equ $FF00
TEST_VERIFY2_STATUS	.equ $FF0A
TEST_ASSERTION2		.equ $FF08
TEST_STATUSES		.equ KERNEL_RAM+$3200
TEST_REGS		.equ $FF10
TEST_IFF_IN		.equ $FF1A
TEST_CRC_BEGIN		.equ $FF0B
TEST_CRC_CALLS		.equ $FF0C
TEST_BUF_LEN		.equ $FF1C
TEST_BUF		.equ TEST_STATUSES
TEST_CRC_EXTRA		.equ $FF0D
TEST_CRC_BEFORE		.equ $FF1E

.org $4000
	jp entry_one
	jp entry_all
	jp entry_iff
	jp entry_two

entry_one:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,(TEST_ASSERTION)
	call kernel_verify
	ld (TEST_VERIFY_STATUS),a
	call iff_flag
	halt

entry_two:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,(TEST_ASSERTION)
	call kernel_verify
	ld (TEST_VERIFY_STATUS),a
	ld hl,(TEST_ASSERTION2)
	call kernel_verify
	ld (TEST_VERIFY2_STATUS),a
	halt

entry_verify:
	di
	ld hl,(TEST_ASSERTION)
	call kernel_verify
	ld (TEST_VERIFY_STATUS),a
	halt

entry_regs:
	di
	ld iy,$1357
	ld bc,$2468
	push bc
	pop af
	ex af,af'
	exx
	ld bc,$369C
	ld de,$48AE
	ld hl,$5AC0
	exx
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,(TEST_ASSERTION)
	call kernel_verify
	ld (TEST_VERIFY_STATUS),a
	ld (TEST_REGS),iy
	ex af,af'
	push af
	pop bc
	ld (TEST_REGS+2),bc
	exx
	ld (TEST_REGS+4),bc
	ld (TEST_REGS+6),de
	ld (TEST_REGS+8),hl
	halt

entry_iffv:
	xor a
	out (3),a
	ld a,(TEST_IFF_IN)
	or a
	jr z,iffv_start
	ei
iffv_start:
	nop
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,(TEST_ASSERTION)
	call kernel_verify
	ld (TEST_VERIFY_STATUS),a
	call iff_flag
	di
	halt

entry_all:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,0
all_next:
	ld de,(TEST_COUNT)
	push hl
	or a
	sbc hl,de
	pop hl
	jr nc,all_done
	push hl
	call kernel_verify
	pop hl
	ld de,TEST_STATUSES
	add hl,de
	ld (hl),a
	or a
	sbc hl,de
	inc hl
	jr all_next
all_done:
	halt

entry_iff:
	xor a
	out (3),a
	ei
	nop
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call iff_flag
	di
	halt

entry_crc:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call crc_run
	halt

entry_crc_raw:
	di
	call crc_run
	halt

entry_crc_second_init:
	di
	call kernel_init
	call kernel_crc_begin
	call kernel_crc_chunk
	ld (TEST_STATUSES),a
	call kernel_init
	ld (TEST_INIT_STATUS),a
	ld hl,(KERNEL_CRC)
	ld (TEST_CRC_BEFORE),hl
	ld hl,(KERNEL_CRC+2)
	ld (TEST_CRC_BEFORE+2),hl
	call kernel_crc_chunk
	ld (TEST_STATUSES+1),a
	halt

entry_crc_again:
	di
	call kernel_init
	call crc_run
	ld hl,(KERNEL_CRC)
	ld (TEST_CRC_BEFORE),hl
	ld hl,(KERNEL_CRC+2)
	ld (TEST_CRC_BEFORE+2),hl
	call kernel_crc_chunk
	ld (TEST_CRC_EXTRA),a
	halt

entry_crc_failed_init:
	di
	call kernel_init
	call kernel_crc_begin
	call kernel_crc_chunk
	ld (TEST_STATUSES),a
	ld a,$80
	ld (KERNEL_LIB_PAGE),a
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call kernel_crc_chunk
	ld (TEST_STATUSES+1),a
	halt

entry_crc_between_verifies:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call kernel_crc_begin
	ld (TEST_CRC_BEGIN),a
	xor a
	ld (TEST_CRC_CALLS),a
cbv_next:
	call kernel_crc_chunk
	ld c,a
	ld a,(TEST_CRC_CALLS)
	ld e,a
	ld d,0
	ld hl,TEST_STATUSES
	add hl,de
	ld (hl),c
	ld l,e
	ld h,d
	call kernel_verify
	ld c,a
	ld a,(TEST_CRC_CALLS)
	ld e,a
	ld d,0
	ld hl,TEST_STATUSES+$80
	add hl,de
	ld (hl),c
	ld hl,TEST_STATUSES
	add hl,de
	inc a
	ld (TEST_CRC_CALLS),a
	ld a,(hl)
	cp ST_CRC_MORE
	jr z,cbv_next
	halt

entry_crc_restart:
	di
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call kernel_crc_begin
	call kernel_crc_chunk
	call crc_run
	halt

entry_crc_refused_iff:
	xor a
	out (3),a
	ld a,(TEST_IFF_IN)
	or a
	jr z,refused_go
	ei
refused_go:
	nop
	call kernel_crc_begin
	ld (TEST_CRC_BEGIN),a
	call iff_flag
	ld a,(TEST_IFF)
	ld (TEST_IFF+1),a
	call kernel_crc_chunk
	ld (TEST_CRC_EXTRA),a
	call iff_flag
	di
	halt

entry_crc_env:
	xor a
	out (3),a
	ld a,(TEST_IFF_IN)
	or a
	jr z,crc_env_go
	ei
crc_env_go:
	nop
	ld iy,$1357
	ld bc,$2468
	push bc
	pop af
	ex af,af'
	exx
	ld bc,$369C
	ld de,$48AE
	ld hl,$5AC0
	exx
	call kernel_init
	ld (TEST_INIT_STATUS),a
	call crc_run
	call iff_flag
	ld (TEST_REGS),iy
	ex af,af'
	push af
	pop bc
	ld (TEST_REGS+2),bc
	exx
	ld (TEST_REGS+4),bc
	ld (TEST_REGS+6),de
	ld (TEST_REGS+8),hl
	di
	halt

entry_crc_vector:
	di
	call crc_table_build
	ld hl,$FFFF
	ld (KERNEL_CRC),hl
	ld (KERNEL_CRC+2),hl
	ld hl,(TEST_BUF_LEN)
	ld de,TEST_BUF
	add hl,de
	ex de,hl
	call crc_update
	halt

crc_run:
	call kernel_crc_begin
	ld (TEST_CRC_BEGIN),a
	xor a
	ld (TEST_CRC_CALLS),a
crc_next:
	ld a,(TEST_CRC_CALLS)
	ld hl,TEST_COUNT
	cp (hl)
	ret nc
	call kernel_crc_chunk
	ld c,a
	ld a,(TEST_CRC_CALLS)
	ld e,a
	ld d,0
	ld hl,TEST_STATUSES
	add hl,de
	ld (hl),c
	inc a
	ld (TEST_CRC_CALLS),a
	ld a,c
	cp ST_CRC_MORE
	jr z,crc_next
	ret

iff_flag:
	ld a,i
	ld a,0
	jp po,iff_store
	inc a
iff_store:
	ld (TEST_IFF),a
	ret

#include "kernel.z80"

#if TEST_STATUSES != KERNEL_RAM_END
 .error "the test variables must start at the end of the kernel block"
#endif
#if TEST_STATUSES+$800 > TEST_BLOCK
 .error "the test variables do not fit above the kernel block"
#endif
