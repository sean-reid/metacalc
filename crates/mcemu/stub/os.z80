; Page 0. Flash pages $40-$6F cannot execute, test pages below them can.
; The services below stand in for the OS entry points an app calls, and are run for real.
TEST_PAGE .equ $20

_GetCSC           .equ $4018
_GetKey           .equ $4972
_JForceCmdNoChar  .equ $4027
_JForceCmd        .equ $402A
_ClrLCDFull       .equ $4540
_GrBufCpy         .equ $486A
_PutC             .equ $4504
_ChkFindSym       .equ $42F1
_EnoughMem        .equ $42FD
_CreateAppVar     .equ $4E6A
_DelVarArc        .equ $4FC6
_Arc_Unarc        .equ $4FD8
_CreateRList      .equ $4315
_LoadDEIndPaged   .equ $501A
_GetBaseVer       .equ $4C6F
_AppInit          .equ $404B

OP1               .equ $8478
E_MEMORY          .equ $8E
E_BAD_CALL        .equ $FF

kbdScanCode       .equ $843F
kbdKey            .equ $8445
cxMain            .equ $858D
CX_VECTORS        .equ 12
gkMods            .equ $8446
plotSScreen       .equ $9340

PORT_KEYS         .equ $01
PORT_STATUS       .equ $02
PORT_INT_STATUS   .equ $04
ON_LATCH          .equ $01
ON_LEVEL          .equ $08
onFlags           .equ 9
flags             .equ $89F0
onInterrupt       .equ 4
PORT_MASK         .equ $03
PORT_LCD_CMD      .equ $10
PORT_LCD_DATA     .equ $11
LCD_READY         .equ $02

JUNK_IX           .equ $1D27
JUNK_AF           .equ $AF5A
JUNK_BC           .equ $BC0B
JUNK_DE           .equ $DE0D
JUNK_HL           .equ $A11A
JUNK_AF2          .equ $AF27
JUNK_BC2          .equ $BC27
JUNK_DE2          .equ $DE27
JUNK_HL2          .equ $A127

.org $0000
	.fill $0028-$,$FF
	jp bcall
	.fill $0038-$,$FF
	jp isr
	.fill $0050-$,$FF
	jp bjump
	.fill $0100-$,$FF

	xor a
	out ($04),a
	ld a,TEST_PAGE
	out ($06),a
	ld a,$81
	out ($07),a
	xor a
	out ($05),a
	out ($20),a
	ld sp,$FFFF
	jp $4000

; Sets the OS break flag when the ON latch on port 4 is up and ON is still down and IY holds the
; flags pointer; a tap over before the handler runs sets nothing. Acknowledges the timer and keypad sources the way the
; hardware needs: the mask on port 3 written as zero and then again. Scans the keys, so a key is
; only seen while interrupts are on. Keeps the main registers and IX and IY; the shadow set is
; left changed.
isr:
	ex af,af'
	exx
	in a,(PORT_INT_STATUS)
	and ON_LATCH | ON_LEVEL
	cp ON_LATCH
	jr nz,isr_no_on
	push iy
	pop hl
	ld de,flags
	or a
	sbc hl,de
	jr nz,isr_no_on
	set onInterrupt,(iy+onFlags)
isr_no_on:
	in a,(PORT_MASK)
	push af
	xor a
	out (PORT_MASK),a
	pop af
	out (PORT_MASK),a
	call scan_keys
	exx
	ex af,af'
	ei
	reti

; Sets kbdScanCode to the one key that is down if it is not the one taken last, tracked in
; kbdKey. Two or more keys down change nothing until one is up; no key down forgets the last.
scan_keys:
	ld de,0
	ld l,0
	ld c,$FE
scan_group:
	ld a,c
	out (PORT_KEYS),a
	in a,(PORT_KEYS)
	cpl
	ld b,8
scan_bit:
	inc e
	rra
	jr nc,scan_up
	inc d
	ld l,e
scan_up:
	djnz scan_bit
	rlc c
	ld a,e
	cp 56
	jr nz,scan_group
	ld a,$FF
	out (PORT_KEYS),a
	ld a,d
	or a
	jr z,scan_idle
	dec a
	ret nz
	ld a,(kbdKey)
	cp l
	ret z
	ld a,l
	ld (kbdKey),a
	ld (kbdScanCode),a
	ret
scan_idle:
	ld (kbdKey),a
	ret

; rst 28h: the two bytes after the call site name the entry point. Registers survive except
; the ones the service returns.
bcall:
	push hl
	push de
	push bc
	push af
	ld hl,8
	add hl,sp
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld a,(de)
	ld c,a
	inc de
	ld a,(de)
	ld b,a
	inc de
	ld (hl),d
	dec hl
	ld (hl),e
	ld hl,bcall_table
bcall_next:
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ld a,d
	or e
	jr z,bcall_missing
	ld a,e
	cp c
	jr nz,bcall_skip
	ld a,d
	cp b
	jr z,bcall_found
bcall_skip:
	inc hl
	inc hl
	jr bcall_next
bcall_found:
	ld e,(hl)
	inc hl
	ld d,(hl)
	ex de,hl
	pop af
	pop bc
	pop de
	ex (sp),hl
	ret

; BC holds the unsupported address when the machine stops here.
bcall_missing:
	di
fault_bcall:
	halt
	jr fault_bcall

; call 50h: the same, and the service never returns. A reaches the service as the caller left it.
bjump:
	ex af,af'
	pop hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	ld hl,bjump_table
bjump_next:
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ld a,d
	or e
	jr z,bjump_missing
	ld a,e
	cp c
	jr nz,bjump_skip
	ld a,d
	cp b
	jr nz,bjump_skip
	ld e,(hl)
	inc hl
	ld d,(hl)
	ex de,hl
	ex af,af'
	jp (hl)
bjump_skip:
	inc hl
	inc hl
	jr bjump_next

bjump_missing:
	di
fault_bjump:
	halt
	jr fault_bjump

bcall_table:
	.dw _GetCSC, get_csc
	.dw _GetKey, get_key
	.dw _ClrLCDFull, clr_lcd_full
	.dw _GrBufCpy, gr_buf_cpy
	.dw _PutC, put_c
	.dw _ChkFindSym, chk_find_sym
	.dw _EnoughMem, enough_mem
	.dw _CreateAppVar, create_app_var
	.dw _DelVarArc, del_var_arc
	.dw _Arc_Unarc, arc_unarc
	.dw _CreateRList, create_r_list
	.dw _LoadDEIndPaged, load_de_ind_paged
	.dw _GetBaseVer, get_base_ver
	.dw _AppInit, app_init
	.dw 0

bjump_table:
	.dw _JForceCmdNoChar, force_cmd_no_char
	.dw _JForceCmd, force_cmd_no_char
	.dw 0

; A and B are the OS version bytes of the reference image, 2 and 2Bh, and the other registers are kept.
get_base_ver:
	ld a,2
	ld b,$2B
	ret

; The app has left. The machine stops here, BC holding the bjump target and A as the app set it.
force_cmd_no_char:
	di
app_exit:
	halt
	jr app_exit

; The app returned to the address the launcher put on its stack. A HALT in the stub always
; ends the run, so the machine stops as the app left it, interrupts included.
app_return:
	halt
	jr app_return

; A returns the key the interrupt handler found and clears it, 0 if none. The flags, BC, DE and
; HL are junk. Returns with interrupts on.
get_csc:
	di
	ld a,(kbdScanCode)
	ld hl,kbdScanCode
	ld (hl),0
	ld bc,JUNK_BC
	ld de,JUNK_DE
	ld hl,JUNK_HL
	cp $FF
	ei
	ret

; A returns the key code TI-OS 2.43 reports for the key taken next, spinning with interrupts open
; until one is down, because a HALT in the stub stops the machine. 2nd and ALPHA set a modifier
; for the next key, within one call, and return nothing, and a key with no code in its table is
; waited out. With the OS break flag set, which ON does, it returns 0 at once and leaves the flag,
; as the OS does.
; Alpha lock and power off are not modelled. A is the code; BC, DE, HL and the shadow set are
; junk, and the flags are whatever the last compare left. IX, IY and SP are kept, and interrupts
; are on.
get_key:
	xor a
	ld (gkMods),a
get_key_wait:
	ei
	nop
	nop
	di
	ld a,(flags+onFlags)
	and 1<<onInterrupt
	jr nz,get_key_break
	ld hl,kbdScanCode
	ld a,(hl)
	ld (hl),0
	or a
	jr z,get_key_wait
	ld b,a
	ld hl,gkMods
	ld a,b
	cp SCAN_2ND
	jr nz,get_key_not_2nd
	set 0,(hl)
	jr get_key_wait
get_key_not_2nd:
	cp SCAN_ALPHA
	jr nz,get_key_look
	set 1,(hl)
	jr get_key_wait
get_key_look:
	ld c,(hl)
	ld (hl),0
	ld hl,key_plain
	bit 0,c
	jr z,get_key_not_2nd_table
	ld hl,key_2nd
	jr get_key_index
get_key_not_2nd_table:
	bit 1,c
	jr z,get_key_index
	ld hl,key_alpha
get_key_index:
	ld d,0
	ld e,b
	dec e
	add hl,de
	ld a,(hl)
	or a
	jr z,get_key_wait
	jr get_key_done
get_key_break:
	xor a
get_key_done:
	push af
	call junk_all
	pop af
	ei
	ret

SCAN_2ND          .equ $36
SCAN_ALPHA        .equ $30

; Indexed by scancode - 1, measured on the reference OS; 0 for a key with no code.
key_plain:
	.db $04,$02,$01,$03,0,0,0,0,$05,$80,$81,$82,$83,$84,$09,0
	.db $8C,$91,$94,$97,$86,$BB,$35,0,$8D,$90,$93,$96,$85,$B9,$2D,$31
	.db $8E,$8F,$92,$95,$8B,$B7,$2C,$B4,0,$8A,$BF,$C1,$BD,$B6,$32,0
	.db $44,$5A,$2E,$48,$49,0,$45,$0A
key_2nd:
	.db 0,$0E,$0F,0,0,0,0,0,$0D,$36,$88,$87,$EF,$B5,$09,0
	.db $C5,$F5,$F8,$FB,$ED,$BC,$38,0,$EE,$F4,$F7,$FA,$EC,$BA,$2F,$3A
	.db $3E,$F3,$F6,$F9,$98,$B8,$39,$41,0,$0C,$C0,$C2,$BE,$37,$33,0
	.db $4A,$3B,$57,$4B,$30,0,$40,$0B
key_alpha:
	.db $04,$02,$01,$03,0,0,0,0,$05,$CB,$B0,$AB,$A6,$A1,$09,0
	.db $CA,$CC,$AF,$AA,$A5,$A0,$35,0,$C6,$B3,$AE,$A9,$A4,$9F,$9C,$31
	.db $99,$B2,$AD,$A8,$A3,$9E,$9B,$B4,0,$B1,$AC,$A7,$A2,$9D,$9A,0
	.db $44,$5A,$2E,$48,$49,0,$45,$0A

; In: HL = the six context vectors. Loads them into cxMain to cxSizeWind and nothing else.
app_init:
	ld de,cxMain
	ld bc,CX_VECTORS
	ldir
	ret

; Draws one character's worth of nothing. Destroys every register but IX, IY and SP and
; returns with interrupts off.
put_c:
	call junk_all
	di
	ret

; Both services write the 12 columns of each of the 64 rows, waiting on the LCD between
; accesses, whatever the CPU speed. They destroy every register but IX, IY and SP. They mask
; interrupts for the copy and return with them on, as TI-OS 2.43 does.
clr_lcd_full:
	di
	ld hl,zero
	ld de,0
	call lcd_blit
	jr lcd_done

gr_buf_cpy:
	di
	ld hl,plotSScreen
	ld de,1
	call lcd_blit
lcd_done:
	call junk_all
	ei
	ret

junk_all:
	exx
	ld bc,JUNK_BC2
	ld de,JUNK_DE2
	ld hl,JUNK_HL2
	exx
	ld bc,JUNK_AF2
	push bc
	pop af
	ex af,af'
	ld bc,JUNK_BC
	ld de,JUNK_DE
	ld hl,JUNK_AF
	push hl
	pop af
	ld hl,JUNK_HL
	ret

; In: HL = the first byte, DE = how far HL moves after each byte. Leaves the controller in the
; increment mode it was in, kept on the stack meanwhile.
lcd_blit:
	in a,(PORT_LCD_CMD)
	and 3
	or 4
	push af
	ld a,$07
	call lcd_command
	ld c,$80
lcd_row:
	ld a,c
	call lcd_command
	ld a,$20
	call lcd_command
	ld b,12
lcd_byte:
	call lcd_wait
	ld a,(hl)
	out (PORT_LCD_DATA),a
	add hl,de
	djnz lcd_byte
	inc c
	ld a,c
	cp $C0
	jr nz,lcd_row
	pop af
	jp lcd_command

lcd_command:
	push af
	call lcd_wait
	pop af
	out (PORT_LCD_CMD),a
	ret

; Waits for the CPU-side LCD wait and then for the controller's own busy bit, which drops a
; write made inside its window. Gives up after 256 polls between the two and stops the machine
; at fault_lcd, with interrupts off.
lcd_wait:
	push bc
	ld b,0
lcd_wait_ready:
	in a,(PORT_STATUS)
	and LCD_READY
	jr nz,lcd_busy
	djnz lcd_wait_ready
	jr lcd_stuck
lcd_busy:
	in a,(PORT_LCD_CMD)
	rla
	jr nc,lcd_wait_ok
	djnz lcd_busy
lcd_stuck:
	di
fault_lcd:
	halt
	jr fault_lcd
lcd_wait_ok:
	pop bc
	ret

zero:
	.db 0

; Run by the launcher before it hands over: the LCD on in 8-bit mode with the cursor at the
; origin, and no key reported yet.
os_init:
	ld a,$03
	call lcd_command
	ld a,$01
	call lcd_command
	ld a,$05
	call lcd_command
	ld a,$40
	call lcd_command
	ld a,$20
	call lcd_command
	ld a,$80
	call lcd_command
	xor a
	ld (kbdScanCode),a
	ld (kbdKey),a
	halt

#include "vars.z80"
