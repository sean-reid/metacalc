; The shapes section: each syntax axiom's parts in reading order. See lib.z80 for the contract.

lib_shapes:
	call lr_need
	ret nz
	ld a,(ls_have)
	and LS_SHAPES
	jp z,lsx_nothing
	ld bc,(ls_sh+3)
	ld hl,(ls_sh)
	ld a,(ls_sh+2)
	ld e,a
	xor a
	ret

lib_shape:
	ld (lr_bufp),de
	ld (lr_cn),hl
	call lr_need
	ret nz
	ld bc,255
	call lr_chkbuf
	ret nz
	ld a,(ls_have)
	and LS_SHAPES
	jp z,lsx_nothing
	ld hl,(lr_cn)
	ld de,(ls_tr_n)
	or a
	sbc hl,de
	jp nc,lr_bad_index
	ld hl,(lr_cn)
	add hl,hl
	ld bc,2
	add hl,bc
	xor a
	ld de,ls_sh
	call lsx_add3
	ld de,lr_hdr
	ld bc,4
	call lr_rd
	ret nz
	ld hl,(lr_hdr+2)
	ld de,(lr_hdr)
	or a
	sbc hl,de
	jp c,lr_bad
	ld a,h
	or a
	jp nz,lr_bad
	ld a,l
	or a
	jp z,lr_bad
	ld (lr_len),a
	ld hl,(lr_hdr)
	xor a
	ld de,ls_sh
	call lsx_add3
	ld (lr_tr),hl
	ld (lr_tr+2),a
	ld hl,(ls_tr_n)
	add hl,hl
	ld bc,4
	add hl,bc
	ex de,hl
	ld hl,(lr_hdr)
	or a
	sbc hl,de
	jp c,lr_bad
	ld hl,(ls_sh+3)
	ld de,(lr_hdr+2)
	or a
	sbc hl,de
	jp c,lr_bad
	ld a,(lr_len)
	ld c,a
	ld b,0
	ld hl,(lr_tr)
	ld a,(lr_tr+2)
	ld (ls_ts),hl
	ld (ls_ts+2),a
	call lr_adv
	jp c,lr_bad
	ld (ls_te),hl
	ld (ls_te+2),a
	call lsx_chunk
	ret nz
	ld hl,(lr_cn)
	ld d,h
	ld e,l
	add hl,hl
	add hl,de
	ld bc,4
	add hl,bc
	xor a
	ld de,ls_tr
	call lsx_add3
	ld de,lr_hdr
	ld bc,1
	call lr_rd
	ret nz
	ld a,(lr_len)
	ld c,a
	ld b,0
	ld hl,(lr_tr)
	ld a,(lr_tr+2)
	ld de,(lr_bufp)
	call lr_rd
	ret nz
	ld a,(lr_hdr)
	ld d,a
	ld a,(lr_len)
	ld b,a
	ld c,0
	ld hl,(lr_bufp)
lsh_scan:
	ld a,(hl)
	inc hl
	or a
	jr z,lsh_scanned
	inc c
	cp d
	jr z,lsh_scanned
	jp nc,lr_bad
lsh_scanned:
	djnz lsh_scan
	ld a,c
	cp d
	jp nz,lr_bad
	ld e,d
lsh_child:
	ld a,e
	or a
	jr z,lsh_done
	ld a,(lr_len)
	ld b,a
	ld c,0
	ld hl,(lr_bufp)
lsh_find:
	ld a,(hl)
	inc hl
	cp e
	jr nz,lsh_next
	inc c
lsh_next:
	djnz lsh_find
	ld a,c
	cp 1
	jp nz,lr_bad
	dec e
	jr lsh_child
lsh_done:
	ld a,(lr_len)
	ld b,a
	xor a
	ret
