; metacalc screen framework: the stack of open screens and the navigation between them, as
; Ui::press in crates/mcui/src/ui.rs does it. It draws nothing and makes no OS call or far call;
; it is given the addresses of each kind's routines and calls them.
;
; Assembling this file alone places it at $4000, with -I at the repository root and at app/src
; so that "scr/ram.inc" and ram_map.inc are found; an including file defines SCR_EMBEDDED first
; and places the code itself.
;
; Frames. SCR_STACK holds up to SCR_MAX_DEPTH (8, the model's MAX_DEPTH) frames of SCR_FRAME (16)
; bytes, the first the bottom screen. Byte 0 of a frame is its screen kind, 1 to 255; 0 is never
; a kind. Bytes 1 to 15 are that screen's position and mean nothing to the framework. The frames
; above the open ones hold stale bytes.
;
; Kinds. scr_init is given a table of 10 byte rows, one per kind, the row of kind k at table +
; (k-1)*10, five little-endian addresses: enter, draw, key, land, idle. Only the top screen has derived
; state, so a screen that becomes the top is entered again from its frame. A kind that is not in
; the table, or kind 0, is a wild jump. Every routine of a kind may destroy every register but
; IY and gets the frame as HL, the frame's address in SCR_STACK, which holds only until the stack
; changes:
;   enter  in HL = frame. out A = 0, or a nonzero status when the screen cannot be built.
;   draw   in HL = frame. Draws the whole frame into the canvas.
;   key    in A = the key (a KEY_ code), B = its character for KEY_LETTER, HL = frame.
;          out A = SCR_STAY, SCR_REDRAW, SCR_PUSH (the new frame's 16 bytes are in scr_new),
;          SCR_POP, or SCR_JUMP (DE = the assertion to land on). Any other value is SCR_STAY.
;   land   in HL = frame, DE = the assertion. Moves the screen to it, after its enter.
;   idle   in HL = frame. Does the screen's pending work, or one bounded slice of it.
;          out A = an action as a key routine returns it, and carry set when more work is
;          pending after this call, clear when none is. SCR_STAY with carry clear means nothing
;          was pending and nothing changed. A kind with no work points idle at a routine that
;          returns A = SCR_STAY with carry clear.
;
; Contracts the code does not check: scr_init runs before any other routine; a kind is 1 to 255 and
; has a row in the table; a key or idle routine that returns SCR_PUSH has filled scr_new with a frame whose
; kind is not 0; after SCR_RES_FAILED from a pop or a jump the uncovered screen has not been entered,
; so the caller runs scr_refresh, or leaves, before the next scr_key or scr_idle.
;
; Variables. SCR_USED (41) bytes of SCR_VARS, laid out in ram.inc; scr_new is the frame a key
; or idle routine writes before it returns SCR_PUSH. Nothing is kept in a register across a call of a
; kind's routine. Only the stack, the variables and scr_new hold state, so all of it survives a
; key wait and an auto power down, except the derived state of the top screen: scr_refresh builds
; it again. The framework never touches IY, the shadow registers or IX, never changes the
; interrupt state, and works with interrupts on.
;
; Stack: counting the caller's return address, scr_key and the other routines use at most 10 bytes
; inside scr_dispatch and at most 4 at the entry of a kind's routine. scr_idle uses at most 12 and
; at most 6 when its action is a push, a pop or a jump. The routines add their own.
;
; Routines:
;   scr_init     in HL = the kind table, DE = the first frame, 16 bytes outside SCR_STACK. Clears
;                the stack, pushes the frame, runs its enter. out A = the enter's status.
;                destroys everything but IY. After a nonzero status one screen is open.
;   scr_key      in A = the key, B = its character. Runs the top screen's key and applies the
;                action as Ui::press does. out A = SCR_RES_IDLE (nothing to redraw),
;                SCR_RES_REDRAW, SCR_RES_LEAVE (SCR_POP with one screen open: CLEAR on the first
;                screen leaves the app, the stack untouched) or SCR_RES_FAILED with B = the status
;                of the enter that failed. SCR_JUMP with one screen open does nothing and returns
;                SCR_RES_IDLE.
;                  PUSH on a full stack removes the frame at index 2 first and moves the frames
;                above it down. When the new top's enter fails, the new frame is removed again,
;                the evicted one is put back at index 2, and the old top is entered again: the
;                stack is as it was before the push.
;                  POP and JUMP remove the top frame, then enter the uncovered screen. JUMP runs
;                its land with the assertion after that. When that enter fails the frame stays
;                removed, land does not run, and the status comes back as SCR_RES_FAILED; the
;                screen's frame is intact, and scr_refresh tries its enter again.
;                destroys everything but IY.
;   scr_idle     Runs the top screen's idle and applies its action as scr_key applies a key's, push
;                with eviction and its failure rule, pop, jump and leave included. out A and B as
;                scr_key, and carry set when the screen on top after the action has more work
;                pending. After SCR_STAY and SCR_REDRAW that is the idle routine's own carry;
;                after a push, pop or jump the framework cannot know and answers carry set, so the
;                next scr_idle asks the new top screen; SCR_RES_LEAVE and SCR_RES_FAILED answer
;                carry clear. The caller calls scr_idle again while carry is set, checking for a
;                waiting key between calls, and waits for a key when it is clear.
;                destroys everything but IY.
;   scr_push_frame
;                in HL = a frame of 16 bytes outside SCR_STACK, whose kind is not 0. Pushes it as
;                a SCR_PUSH from a key routine does, with the same eviction and failure rules, for
;                a caller that is not a key routine. out A and B as scr_key. destroys everything
;                but IY.
;   scr_draw     runs the top screen's draw. destroys everything but IY.
;   scr_refresh  runs the top screen's enter and nothing else, for after the derived state is
;                gone. out A = its status. destroys everything but IY.
;   scr_top      out HL = the top frame. destroys nothing else.
;   scr_depth    out A = the number of open screens, 1 to SCR_MAX_DEPTH. destroys nothing else.

#ifndef SCR_EMBEDDED
.org $4000
#endif

#include "scr/ram.inc"

SCR_STAY                .equ 0
SCR_REDRAW              .equ 1
SCR_PUSH                .equ 2
SCR_POP                 .equ 3
SCR_JUMP                .equ 4

SCR_RES_IDLE            .equ 0
SCR_RES_REDRAW          .equ 1
SCR_RES_LEAVE           .equ 2
SCR_RES_FAILED          .equ 3

SCR_AT_ENTER               .equ 0
SCR_AT_DRAW                .equ 2
SCR_AT_KEY                 .equ 4
SCR_AT_LAND                .equ 6
SCR_AT_IDLE                .equ 8

scr_init:
	ld (scr_table),hl
	push de
	ld hl,SCR_STACK
	ld de,SCR_STACK+1
	ld bc,SCR_STACK_BYTES-1
	ld (hl),0
	ldir
	pop hl
	ld de,SCR_STACK
	ld bc,SCR_FRAME
	ldir
	ld a,1
	ld (scr_count),a
	jr scr_refresh

scr_depth:
	ld a,(scr_count)
	ret

scr_draw:
	ld c,SCR_AT_DRAW
	jr scr_on_top

scr_refresh:
	ld c,SCR_AT_ENTER

; in C = the routine's offset in the row, A, B and DE as that routine takes them
scr_on_top:
	call scr_top

; in C = the routine's offset in the row, HL = a frame, A, B and DE as that routine takes them.
; Jumps to the routine, which returns to the caller.
scr_dispatch:
	push af
	push de
	push hl
	ld a,(hl)
	dec a
	ld l,a
	ld h,0
	add hl,hl
	ld e,l
	ld d,h
	add hl,hl
	add hl,hl
	add hl,de
	ld a,c
	ld de,(scr_table)
	add hl,de
	ld e,a
	ld d,0
	add hl,de
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (scr_vec),de
	pop hl
	pop de
	pop af
	push hl
	ld hl,(scr_vec)
	ex (sp),hl
	ret

scr_top:
	push af
	ld a,(scr_count)
	dec a
	rlca
	rlca
	rlca
	rlca
	add a,SCR_STACK & $FF
	ld l,a
	ld a,SCR_STACK >> 8
	adc a,0
	ld h,a
	pop af
	ret

scr_key:
	ld c,SCR_AT_KEY
	call scr_on_top

; in A = the action a routine returned, DE = its assertion for SCR_JUMP
sk_apply:
	cp SCR_PUSH
	jr z,sk_push
	cp SCR_POP
	jr z,sk_pop
	cp SCR_JUMP
	jr z,sk_jump
	cp SCR_REDRAW
	jr z,sk_redraw
	jr sk_idle

sk_pop:
	ld a,(scr_count)
	dec a
	jr z,sk_leave
	ld (scr_count),a
	call scr_refresh
	or a
	jr nz,sk_failed
sk_redraw:
	ld a,SCR_RES_REDRAW
	ret
sk_leave:
	ld a,SCR_RES_LEAVE
	ret

sk_jump:
	ld (scr_de),de
	ld a,(scr_count)
	dec a
	jr z,sk_idle
	ld (scr_count),a
	call scr_refresh
	or a
	jr nz,sk_failed
	ld de,(scr_de)
	ld c,SCR_AT_LAND
	call scr_on_top
	jr sk_redraw
sk_idle:
	ld a,SCR_RES_IDLE
	ret

sk_failed:
	ld b,a
	ld a,SCR_RES_FAILED
	ret

scr_push_frame:
	ld de,scr_new
	ld bc,SCR_FRAME
	ldir
sk_push:
	xor a
	ld (scr_evicted),a
	ld a,(scr_count)
	cp SCR_MAX_DEPTH
	jr nz,sk_add
	ld hl,SCR_FRAME_2
	ld de,scr_evict
	ld bc,SCR_FRAME
	ldir
	ld hl,SCR_FRAME_3
	ld de,SCR_FRAME_2
	ld bc,SCR_SHIFT
	ldir
	ld a,SCR_MAX_DEPTH-1
	ld (scr_count),a
	ld a,1
	ld (scr_evicted),a
sk_add:
	ld hl,scr_count
	inc (hl)
	call scr_top
	ex de,hl
	ld hl,scr_new
	ld bc,SCR_FRAME
	ldir
	call scr_refresh
	or a
	jr z,sk_redraw
	ld (scr_status),a
	ld hl,scr_count
	dec (hl)
	ld a,(scr_evicted)
	or a
	jr z,sk_reenter
	ld hl,SCR_LAST_OLD
	ld de,SCR_LAST_NEW
	ld bc,SCR_SHIFT
	lddr
	ld hl,scr_evict
	ld de,SCR_FRAME_2
	ld bc,SCR_FRAME
	ldir
	ld a,SCR_MAX_DEPTH
	ld (scr_count),a
sk_reenter:
	call scr_refresh
	or a
	jr nz,sk_failed
	ld a,(scr_status)
	jr sk_failed

scr_idle:
	ld c,SCR_AT_IDLE
	call scr_on_top
	ld c,0
	rl c
	cp SCR_PUSH
	jr z,si_moved
	cp SCR_POP
	jr z,si_moved
	cp SCR_JUMP
	jr z,si_moved
	cp SCR_REDRAW
	ld a,SCR_RES_IDLE
	jr nz,si_carry
	ld a,SCR_RES_REDRAW
si_carry:
	rr c
	ret
si_moved:
	call sk_apply
	; carry set for SCR_RES_IDLE and SCR_RES_REDRAW, clear for SCR_RES_LEAVE and SCR_RES_FAILED
	cp SCR_RES_LEAVE
	ret
