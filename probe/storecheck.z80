#include "equates.inc"

; Runs the commands of the AppVar MCCMD against the status table and logs what each returns, then
; draws the log as hex. The table is the AppVar MCPROB, so a calculator's MCSTAT is never touched.
; With no MCCMD the app runs the script at default_script, which deletes any MCPROB first and last,
; whoever made it. A build with SCRIPT_IN_RAM defined reads no MCCMD and has no default script: it
; runs what the host left at SCRIPT, ended by CMD_END, for a test on an OS where the host cannot
; create a variable.
;
; MCCMD holds the commands, each a command byte and its arguments, ended by CMD_END. Words
; and the CRC are little endian. The app copies the script to RAM, so creating or deleting
; variables cannot move it.
;     CMD_OPEN       crc (4), count (2)    log: A, B
;     CMD_GET        n (2)                 log: A, B
;     CMD_SET        n (2), value (1)      log: A
;     CMD_GET_NEXT                         log: A, next (2)
;     CMD_SET_NEXT   n (2)                 log: A
;     CMD_COUNT                            log: A, four counts (8)
;     CMD_COUNT_TO   n (2)                 log: A, four counts (8), A5h bytes if refused
;     CMD_COUNT_ENDS k (1), k ends (2 each) log: A, k, the 64 bytes of results, A5h where unwritten
;     CMD_RESET                            log: A
;     CMD_MAKE       letter, size (2)      log: 0 made, 1 refused for room
;     CMD_DELETE     letter                log: 0 deleted, 1 absent
;     CMD_LOCATE                           log: 0 in RAM, 1 absent, 2 archived; data pointer (2), size (2)
;     CMD_DROP                             deletes the table; log: 0 deleted, 1 absent
;     CMD_HAS        crc (4), count (2)    log: A
;     CMD_ALL_ONES   k (1), k words        log: A, B
;     CMD_NEXT_ZERO  from (2), end (2)     log: A, the answer (2)
;     CMD_NEXT_NOT_ONE from (2), end (2)   log: A, the answer (2)
;     CMD_PREV_NOT_ONE from (2)            log: A, the answer (2)
;     CMD_LIST       dim (2)               creates the list named Q, which sorts below every AppVar; log: 0
;     CMD_ROOM       n (2)                 log: 0 if _EnoughMem accepts n bytes, 1 if not
;     CMD_NOP                              log: 0
;     CMD_REPEAT     n (2)                 runs the next command n times and logs the last
;     CMD_WAIT                             holds the screen until CLEAR after the last command
; The log starts at LOG with the address one past its end, then one record per command: the
; command byte, then what is listed above. A script in the archive logs FFh, 2 and runs nothing.
; A record that would start at or past LOG_LIMIT is dropped, and so is every later one. CMD_MAKE
; and CMD_LIST leave their variables on the calculator; the default script uses neither.
; The screen shows the first 120 bytes of the log, 12 bytes to a row of 24 hex digits.

CMD_END      = 0
CMD_OPEN     = 1
CMD_GET      = 2
CMD_SET      = 3
CMD_GET_NEXT = 4
CMD_SET_NEXT = 5
CMD_COUNT    = 6
CMD_RESET    = 7
CMD_MAKE     = 8
CMD_DELETE   = 9
CMD_LOCATE   = 10
CMD_NOP      = 11
CMD_REPEAT   = 12
CMD_WAIT     = 13
CMD_ROOM     = 15
CMD_LIST     = 16
CMD_COUNT_TO   = 17
CMD_COUNT_ENDS = 18
CMD_DROP       = 19
CMD_HAS        = 20
CMD_ALL_ONES   = 21
CMD_NEXT_ZERO  = 22
CMD_NEXT_NOT_ONE = 23
CMD_PREV_NOT_ONE = 24
SCRIPT_ARCHIVED = 0FFh

#include "storeram.inc"
LOG_LIMIT   = LOG + LOG_LIMIT_OFF
S_PTR       = STATE
S_AT        = STATE + 2
S_REPEAT    = STATE + 4
S_WAIT      = STATE + 6
S_CMD       = STATE + 7
S_RES_LEN   = STATE + 8
S_RES       = STATE + 9
S_TMP       = STATE + 76
S_COUNTS    = STATE + 80
S_DRAW      = STATE + 92

#define APP_NAME "storechk"
#define STORE_VAR "MCPROB"
#include "header.inc"

start:
	ld hl, LOG + 2
	ld (LOG), hl
	xor a
	ld (S_WAIT), a
	ld hl, 0
	ld (S_REPEAT), hl
	call load_script
	jr nz, finish
	ld hl, SCRIPT
	ld (S_PTR), hl
next:
	ld hl, (S_PTR)
	ld (S_AT), hl
	call fetch
	or a
	jr z, finish
	cp CMD_REPEAT
	jr nz, run
	call fetch_word
	ld a, h
	or l
	jr z, set_repeat
	dec hl
set_repeat:
	ld (S_REPEAT), hl
	jr next
run:
	ld (S_CMD), a
	ld b, a
	ld hl, S_RES
	ld (hl), a
	ld a, 2
	ld (S_RES_LEN), a
	ld a, b
	call dispatch
	ld hl, (S_REPEAT)
	ld a, h
	or l
	jr z, record
	dec hl
	ld (S_REPEAT), hl
	ld hl, (S_AT)
	inc hl
	ld (S_PTR), hl
	ld a, (S_CMD)
	jr run
record:
	call log_result
	jr next

finish:
	call draw_log
	ld a, (S_WAIT)
	or a
	jr z, leave
	ei
wait_for_clear:
	halt
	bcall(_GetCSC)
	cp skClear
	jr nz, wait_for_clear
leave:
	bjump(_JForceCmdNoChar)

; Out: A = next script byte.
fetch:
	ld hl, (S_PTR)
	ld a, (hl)
	inc hl
	ld (S_PTR), hl
	ret

; Out: HL = next script word.
fetch_word:
	call fetch
	push af
	call fetch
	ld h, a
	pop af
	ld l, a
	ret

#ifdef SCRIPT_IN_RAM
load_script:
	xor a
	ret
#else
#include "storescript.inc"
#endif

dispatch:
	cp CMD_OPEN
	jp z, do_open
	cp CMD_GET
	jp z, do_get
	cp CMD_SET
	jp z, do_set
	cp CMD_GET_NEXT
	jp z, do_get_next
	cp CMD_SET_NEXT
	jp z, do_set_next
	cp CMD_COUNT
	jp z, do_count
	cp CMD_RESET
	jp z, do_reset
	cp CMD_MAKE
	jp z, do_make
	cp CMD_DELETE
	jp z, do_delete
	cp CMD_LOCATE
	jp z, do_locate
	cp CMD_COUNT_TO
	jp z, do_count_to
	cp CMD_COUNT_ENDS
	jp z, do_count_ends
	cp CMD_DROP
	jp z, do_drop
	cp CMD_HAS
	jp z, do_has
	cp CMD_ALL_ONES
	jp z, do_all_ones
	cp CMD_NEXT_ZERO
	jp z, do_next_zero
	cp CMD_NEXT_NOT_ONE
	jp z, do_next_not_one
	cp CMD_PREV_NOT_ONE
	jp z, do_prev_not_one
	cp CMD_LIST
	jp z, do_list
	cp CMD_ROOM
	jp z, do_room
	cp CMD_WAIT
	jr nz, do_nop
	ld a, 1
	ld (S_WAIT), a
do_nop:
	xor a
	jp result_a

; In: A = the status, which becomes the first byte after the command byte.
result_a:
	ld (S_RES + 1), a
	ret

do_open:
	call fetch_word
	ld (S_TMP), hl
	call fetch_word
	ld (S_TMP + 2), hl
	call fetch_word
	ld b, h
	ld c, l
	ld hl, (S_TMP)
	ld de, (S_TMP + 2)
	call store_open
	ld (S_RES + 1), a
	ld a, b
	ld (S_RES + 2), a
	ld a, 3
	jp result_len

do_has:
	call fetch_word
	ld (S_TMP), hl
	call fetch_word
	ld (S_TMP + 2), hl
	call fetch_word
	ld b, h
	ld c, l
	ld hl, (S_TMP)
	ld de, (S_TMP + 2)
	call store_has
	jp result_a

do_all_ones:
	call fetch
	ld c, a
	ld b, 0
	ld hl, (S_PTR)
	push hl
	add hl, bc
	add hl, bc
	ld (S_PTR), hl
	pop hl
	call store_all_ones
	ld (S_RES + 1), a
	ld a, b
	ld (S_RES + 2), a
	ld a, 3
	jp result_len

do_next_zero:
	call fetch_word
	push hl
	call fetch_word
	ex de, hl
	pop hl
	call store_next_zero
	ld (S_RES + 1), a
	ld (S_RES + 2), hl
	ld a, 4
	jp result_len

do_next_not_one:
	call fetch_word
	push hl
	call fetch_word
	ex de, hl
	pop hl
	call store_next_not_one
	ld (S_RES + 1), a
	ld (S_RES + 2), hl
	ld a, 4
	jp result_len

do_prev_not_one:
	call fetch_word
	call store_prev_not_one
	ld (S_RES + 1), a
	ld (S_RES + 2), hl
	ld a, 4
	jp result_len

do_get:
	call fetch_word
	call store_get
	ld (S_RES + 1), a
	ld a, b
	ld (S_RES + 2), a
	ld a, 3
	jp result_len

do_set:
	call fetch_word
	push hl
	call fetch
	ld b, a
	pop hl
	call store_set
	jp result_a

do_get_next:
	call store_get_next
	ld (S_RES + 1), a
	ld (S_RES + 2), hl
	ld a, 4
	jp result_len

do_set_next:
	call fetch_word
	call store_set_next
	jp result_a

do_count:
	ld hl, S_COUNTS
	call store_count
count_done:
	ld (S_RES + 1), a
	ld hl, S_COUNTS
	ld de, S_RES + 2
	ld bc, 8
	ldir
	ld a, 10
	jp result_len

do_count_to:
	call fetch_word
	push hl
	ld hl, S_COUNTS
	ld d, h
	ld e, l
	inc de
	ld (hl), 0A5h
	ld bc, 7
	ldir
	pop de
	ld hl, S_COUNTS
	call store_count_to
	jr count_done

do_count_ends:
	ld hl, (S_PTR)
	push hl
	ld c, (hl)
	ld a, c
	ld (S_RES + 2), a
	ld b, 0
	sla c
	rl b
	inc bc
	add hl, bc
	ld (S_PTR), hl
	ld hl, S_RES + 3
	ld d, h
	ld e, l
	inc de
	ld (hl), 0A5h
	ld bc, 63
	ldir
	ld a, 67
	ld (S_RES_LEN), a
	pop hl
	ld de, S_RES + 3
	call store_count_ends
	ld (S_RES + 1), a
	ret

do_reset:
	call store_reset
	jp result_a

do_make:
	call fetch
	ld (S_TMP), a
	call fetch_word
	push hl
	ld de, 16
	add hl, de
	bcall(_EnoughMem)
	pop hl
	jr nc, make_room
	ld a, 1
	jp result_a
make_room:
	push hl
	call letter_name
	pop hl
	bcall(_CreateAppVar)
	xor a
	jp result_a

do_delete:
	call fetch
	ld (S_TMP), a
	call letter_name
	jr delete_named

do_drop:
	call store_name
delete_named:
	bcall(_ChkFindSym)
	jr nc, delete_found
	ld a, 1
	jp result_a
delete_found:
	bcall(_DelVarArc)
	xor a
	jp result_a

do_list:
	call fetch_word
	push hl
	ld hl, list_name
	ld de, OP1
	ld bc, 4
	ldir
	pop hl
	bcall(_CreateRList)
	xor a
	jp result_a

list_name:
	.db 1, 5Dh, 'Q', 0

do_room:
	call fetch_word
	bcall(_EnoughMem)
	sbc a, a
	and 1
	jp result_a

; OP1 = the AppVar named by the letter in S_TMP.
letter_name:
	ld hl, OP1
	ld (hl), appVarObj
	inc hl
	ld a, (S_TMP)
	ld (hl), a
	inc hl
	ld (hl), 0
	ret

do_locate:
	call store_name
	bcall(_ChkFindSym)
	jr nc, locate_found
	ld a, 1
	jp result_a
locate_found:
	ld a, b
	or a
	jr z, locate_ram
	ld a, 2
	jp result_a
locate_ram:
	ld (S_RES + 2), de
	ex de, hl
	ld e, (hl)
	inc hl
	ld d, (hl)
	ld (S_RES + 4), de
	xor a
	ld (S_RES + 1), a
	ld a, 6
	jp result_len

; In: A = bytes of the result, the command byte included.
result_len:
	ld (S_RES_LEN), a
	ret

; Appends the result to the log unless it is full.
log_result:
	ld hl, (LOG)
	ld de, LOG_LIMIT
	or a
	sbc hl, de
	ret nc
	ld hl, (LOG)
	ex de, hl
	ld hl, S_RES
	ld a, (S_RES_LEN)
	ld c, a
	ld b, 0
	ldir
	ld (LOG), de
	ret

#include "storedraw.inc"
#include "store.inc"
#include "storeguard.inc"
