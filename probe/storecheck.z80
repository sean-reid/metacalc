#include "equates.inc"

; Runs the commands of the AppVar MCCMD against the status table and logs what each returns, then
; draws the log as hex. The table is the AppVar MCPROB, so a calculator's MCSTAT is never touched.
; With no MCCMD the app runs the script at default_script, which deletes MCPROB first and last.
;
; MCCMD holds the commands, each a command byte and its arguments, ended by CMD_END. Words
; and the CRC are little endian. The app copies the script to RAM, so creating or deleting
; variables cannot move it.
;     CMD_OPEN       crc (4), count (2)    log: A, B
;     CMD_GET        n (2)                 log: A, B
;     CMD_SET        n (2), value (1)      log: A
;     CMD_GET_NEXT                         log: A, next (2)
;     CMD_SET_NEXT   n (2)                 log: A
;     CMD_COUNT                            log: A, four counts (8)
;     CMD_COUNT_TO   n (2)                 log: A, four counts (8), A5h bytes if refused
;     CMD_COUNT_ENDS k (1), k ends (2 each) log: A, k, 8 bytes per end up to 8 ends, A5h bytes if refused
;     CMD_RESET                            log: A
;     CMD_MAKE       letter, size (2)      log: 0 made, 1 refused for room
;     CMD_DELETE     letter                log: 0 deleted, 1 absent
;     CMD_LOCATE                           log: 0 in RAM, 1 absent, 2 archived; data pointer (2), size (2),
;                                          symbol table entry (2)
;     CMD_DROP                             deletes the table; log: 0 deleted, 1 absent
;     CMD_ARCHIVE                          moves the table to or from the archive; log: 0 moved, 1 absent
;     CMD_LEAVE      n (2)                 creates MCFILL so that n bytes of RAM stay free; log: 0, free
;                                          before (2) and after (2); 1 if n is more than is free
;     CMD_LIST       dim (2)               creates the list named Q, which sorts below every AppVar; log: 0
;     CMD_FILL       size (2)              creates MCFILL with no room check; log: 0
;     CMD_ROOM       n (2)                 log: 0 if _EnoughMem accepts n bytes, 1 if not
;     CMD_NOP                              log: 0
;     CMD_REPEAT     n (2)                 runs the next command n times and logs the last
;     CMD_WAIT                             holds the screen until CLEAR after the last command
; The log starts at LOG with the address one past its end, then one record per command: the
; command byte, then what is listed above. The screen shows the first 120 bytes of the log,
; 12 bytes to a row of 24 hex digits.

CMD_END      = 0
CMD_OPEN     = 1
CMD_GET      = 2
CMD_SET      = 3
CMD_GET_NEXT = 4
CMD_SET_NEXT = 5
CMD_COUNT    = 6
CMD_RESET    = 7
CMD_MAKE     = 8
CMD_DELETE   = 9
CMD_LOCATE   = 10
CMD_NOP      = 11
CMD_REPEAT   = 12
CMD_WAIT     = 13
CMD_FILL     = 14
CMD_ROOM     = 15
CMD_LIST     = 16
CMD_COUNT_TO   = 17
CMD_COUNT_ENDS = 18
CMD_DROP       = 19
CMD_ARCHIVE    = 20
CMD_LEAVE      = 21
; What creating MCFILL takes beyond its data: the size word and the symbol table entry.
FILL_COST      = 15

#include "storeram.inc"
LOG_LIMIT   = LOG + LOG_LIMIT_OFF
S_PTR       = STATE
S_AT        = STATE + 2
S_REPEAT    = STATE + 4
S_WAIT      = STATE + 6
S_CMD       = STATE + 7
S_RES_LEN   = STATE + 8
S_RES       = STATE + 9
S_TMP       = STATE + 76
S_COUNTS    = STATE + 80
S_DRAW      = STATE + 92

; CMD_LEAVE needs the OS's _MemChk, which the stub does not have. A build with SCRIPT_IN_RAM defined
; runs the script already at SCRIPT, ended by CMD_END, and ignores MCCMD.
#define APP_NAME "storechk"
#define STORE_VAR "MCPROB"
#include "header.inc"

start:
	ld hl, LOG + 2
	ld (LOG), hl
	xor a
	ld (S_WAIT), a
	ld hl, 0
	ld (S_REPEAT), hl
	call load_script
	jr nz, finish
	ld hl, SCRIPT
	ld (S_PTR), hl
next:
	ld hl, (S_PTR)
	ld (S_AT), hl
	call fetch
	or a
	jr z, finish
	cp CMD_REPEAT
	jr nz, run
	call fetch_word
	ld a, h
	or l
	jr z, set_repeat
	dec hl
set_repeat:
	ld (S_REPEAT), hl
	jr next
run:
	ld (S_CMD), a
	ld b, a
	ld hl, S_RES
	ld (hl), a
	ld a, 2
	ld (S_RES_LEN), a
	ld a, b
	call dispatch
	ld hl, (S_REPEAT)
	ld a, h
	or l
	jr z, record
	dec hl
	ld (S_REPEAT), hl
	ld hl, (S_AT)
	inc hl
	ld (S_PTR), hl
	ld a, (S_CMD)
	jr run
record:
	call log_result
	jr next

finish:
	call draw_log
	ld a, (S_WAIT)
	or a
	jr z, leave
	ei
wait_for_clear:
	halt
	bcall(_GetCSC)
	cp skClear
	jr nz, wait_for_clear
leave:
	bjump(_JForceCmdNoChar)

; Out: A = next script byte.
fetch:
	ld hl, (S_PTR)
	ld a, (hl)
	inc hl
	ld (S_PTR), hl
	ret

; Out: HL = next script word.
fetch_word:
	call fetch
	push af
	call fetch
	ld h, a
	pop af
	ld l, a
	ret

#ifdef SCRIPT_IN_RAM
load_script:
	xor a
	ret
#else
; Copies MCCMD to SCRIPT, ended by a zero byte, or the default script when there is no MCCMD.
; Out: Z.
load_script:
	ld hl, OP1
	ld (hl), appVarObj
	inc hl
	ld (hl), 'M'
	inc hl
	ld (hl), 'C'
	inc hl
	ld (hl), 'C'
	inc hl
	ld (hl), 'M'
	inc hl
	ld (hl), 'D'
	inc hl
	ld (hl), 0
	bcall(_ChkFindSym)
	jr c, no_script
	ld a, b
	or a
	jr nz, no_script
	ex de, hl
	ld c, (hl)
	inc hl
	ld b, (hl)
	inc hl
	ld de, SCRIPT_MAX - 1
	ld a, b
	cp d
	jr c, size_ok
	jr nz, size_cap
	ld a, c
	cp e
	jr c, size_ok
size_cap:
	ld b, d
	ld c, e
size_ok:
	ld de, SCRIPT
	ld a, b
	or c
	jr z, script_end
	ldir
script_end:
	xor a
	ld (de), a
	ret
no_script:
	ld hl, default_script
	ld de, SCRIPT
	ld bc, default_script_end - default_script
	ldir
	xor a
	ret

; The script of a bare run: a table of 10 entries holding 1 0 2 3 1 0 3 0 0 2, counted whole, to
; 6 and to 11, which is refused, and by two lists of ends, the second not rising and refused.
default_script:
	.db CMD_DROP
	.db CMD_OPEN, 026h, 039h, 0F4h, 0CBh, 10, 0
	.db CMD_SET, 0, 0, 1
	.db CMD_SET, 2, 0, 2
	.db CMD_SET, 3, 0, 3
	.db CMD_SET, 4, 0, 1
	.db CMD_SET, 6, 0, 3
	.db CMD_SET, 9, 0, 2
	.db CMD_GET, 9, 0
	.db CMD_COUNT_ENDS, 3, 3, 0, 6, 0, 10, 0
	.db CMD_COUNT
	.db CMD_COUNT_TO, 6, 0
	.db CMD_COUNT_TO, 11, 0
	.db CMD_COUNT_ENDS, 2, 6, 0, 3, 0
	.db CMD_DROP
	.db CMD_END
default_script_end:
#endif

dispatch:
	cp CMD_OPEN
	jp z, do_open
	cp CMD_GET
	jp z, do_get
	cp CMD_SET
	jp z, do_set
	cp CMD_GET_NEXT
	jp z, do_get_next
	cp CMD_SET_NEXT
	jp z, do_set_next
	cp CMD_COUNT
	jp z, do_count
	cp CMD_RESET
	jp z, do_reset
	cp CMD_MAKE
	jp z, do_make
	cp CMD_DELETE
	jp z, do_delete
	cp CMD_LOCATE
	jp z, do_locate
	cp CMD_COUNT_TO
	jp z, do_count_to
	cp CMD_COUNT_ENDS
	jp z, do_count_ends
	cp CMD_DROP
	jp z, do_drop
	cp CMD_ARCHIVE
	jp z, do_archive
	cp CMD_LEAVE
	jp z, do_leave
	cp CMD_LIST
	jp z, do_list
	cp CMD_FILL
	jp z, do_fill
	cp CMD_ROOM
	jp z, do_room
	cp CMD_WAIT
	jr nz, do_nop
	ld a, 1
	ld (S_WAIT), a
do_nop:
	xor a
	jp result_a

; In: A = the status, which becomes the first byte after the command byte.
result_a:
	ld (S_RES + 1), a
	ret

do_open:
	call fetch_word
	ld (S_TMP), hl
	call fetch_word
	ld (S_TMP + 2), hl
	call fetch_word
	ld b, h
	ld c, l
	ld hl, (S_TMP)
	ld de, (S_TMP + 2)
	call store_open
	ld (S_RES + 1), a
	ld a, b
	ld (S_RES + 2), a
	ld a, 3
	jp result_len

do_get:
	call fetch_word
	call store_get
	ld (S_RES + 1), a
	ld a, b
	ld (S_RES + 2), a
	ld a, 3
	jp result_len

do_set:
	call fetch_word
	push hl
	call fetch
	ld b, a
	pop hl
	call store_set
	jp result_a

do_get_next:
	call store_get_next
	ld (S_RES + 1), a
	ld (S_RES + 2), hl
	ld a, 4
	jp result_len

do_set_next:
	call fetch_word
	call store_set_next
	jp result_a

do_count:
	ld hl, S_COUNTS
	call store_count
count_done:
	ld (S_RES + 1), a
	ld hl, S_COUNTS
	ld de, S_RES + 2
	ld bc, 8
	ldir
	ld a, 10
	jp result_len

do_count_to:
	call fetch_word
	push hl
	ld hl, S_COUNTS
	ld d, h
	ld e, l
	inc de
	ld (hl), 0A5h
	ld bc, 7
	ldir
	pop de
	ld hl, S_COUNTS
	call store_count_to
	jr count_done

do_count_ends:
	ld hl, (S_PTR)
	push hl
	ld c, (hl)
	ld a, c
	ld (S_RES + 2), a
	ld b, 0
	sla c
	rl b
	inc bc
	add hl, bc
	ld (S_PTR), hl
	ld hl, S_RES + 3
	ld d, h
	ld e, l
	inc de
	ld (hl), 0A5h
	ld bc, 63
	ldir
	ld a, (S_RES + 2)
	cp 9
	jr c, ends_len
	ld a, 8
ends_len:
	add a, a
	add a, a
	add a, a
	add a, 3
	ld (S_RES_LEN), a
	pop hl
	ld de, S_RES + 3
	call store_count_ends
	ld (S_RES + 1), a
	ret

do_reset:
	call store_reset
	jp result_a

do_make:
	call fetch
	ld (S_TMP), a
	call fetch_word
	push hl
	ld de, 16
	add hl, de
	bcall(_EnoughMem)
	pop hl
	jr nc, make_room
	ld a, 1
	jp result_a
make_room:
	push hl
	call letter_name
	pop hl
	bcall(_CreateAppVar)
	xor a
	jp result_a

do_delete:
	call fetch
	ld (S_TMP), a
	call letter_name
	jr delete_named

do_drop:
	call store_name
delete_named:
	bcall(_ChkFindSym)
	jr nc, delete_found
	ld a, 1
	jp result_a
delete_found:
	bcall(_DelVarArc)
	xor a
	jp result_a

do_archive:
	call store_name
	bcall(_ChkFindSym)
	jr nc, archive_found
	ld a, 1
	jp result_a
archive_found:
	call store_name
	bcall(_Arc_Unarc)
	xor a
	jp result_a

do_leave:
	call fetch_word
	push hl
	bcall(_MemChk)
	ld (S_RES + 2), hl
	pop de
	or a
	sbc hl, de
	jr c, leave_no
	ld de, FILL_COST
	or a
	sbc hl, de
	jr nc, leave_make
leave_no:
	ld a, 1
	jp result_a
leave_make:
	push hl
	ld hl, fill_name
	ld de, OP1
	ld bc, 9
	ldir
	pop hl
	bcall(_CreateAppVar)
	bcall(_MemChk)
	ld (S_RES + 4), hl
	xor a
	ld (S_RES + 1), a
	ld a, 6
	jp result_len

do_list:
	call fetch_word
	push hl
	ld hl, list_name
	ld de, OP1
	ld bc, 4
	ldir
	pop hl
	bcall(_CreateRList)
	xor a
	jp result_a

list_name:
	.db 1, 5Dh, 'Q', 0

do_fill:
	call fetch_word
	push hl
	ld hl, fill_name
	ld de, OP1
	ld bc, 9
	ldir
	pop hl
	bcall(_CreateAppVar)
	xor a
	jp result_a

fill_name:
	.db appVarObj, "MCFILL", 0, 0

do_room:
	call fetch_word
	bcall(_EnoughMem)
	sbc a, a
	and 1
	jp result_a

; OP1 = the AppVar named by the letter in S_TMP.
letter_name:
	ld hl, OP1
	ld (hl), appVarObj
	inc hl
	ld a, (S_TMP)
	ld (hl), a
	inc hl
	ld (hl), 0
	ret

do_locate:
	call store_name
	bcall(_ChkFindSym)
	jr nc, locate_found
	ld a, 1
	jp result_a
locate_found:
	ld (S_RES + 6), hl
	ld a, b
	or a
	jr z, locate_ram
	ld a, 2
	jp result_a
locate_ram:
	ld (S_RES + 2), de
	ex de, hl
	ld e, (hl)
	inc hl
	ld d, (hl)
	ld (S_RES + 4), de
	xor a
	ld (S_RES + 1), a
	ld a, 8
	jp result_len

; In: A = bytes of the result, the command byte included.
result_len:
	ld (S_RES_LEN), a
	ret

; Appends the result to the log unless it is full.
log_result:
	ld hl, (LOG)
	ld de, LOG_LIMIT
	or a
	sbc hl, de
	ret nc
	ld hl, (LOG)
	ex de, hl
	ld hl, S_RES
	ld a, (S_RES_LEN)
	ld c, a
	ld b, 0
	ldir
	ld (LOG), de
	ret

#include "storedraw.inc"
#include "store.inc"
#include "storeguard.inc"
