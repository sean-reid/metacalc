; metacalc proof kernel for the TI-84 Plus SE. Checks a library in format MCL1
; (crates/mcpack/src/library/mod.rs) and accepts or refuses what the host model
; mcpack::library::Kernel does, with four differences. The CRC-32 in the header is checked by
; kernel_crc_begin and kernel_crc_chunk, not by kernel_init. The header's length field is
; trusted: the model requires it to equal the library's real size, the kernel requires it to be
; at least the header, below 2^24 and within the flash pages left, and reads no further than it.
; Limits above a buffer's capacity are clamped to it, where the model takes them as given.
; kernel_init and kernel_verify can return ST_INTERRUPTED, which the model never does.
;
; Code runs from flash in bank A and is position dependent. Assembling this file
; alone places it at $4000; an including file defines KERNEL_EMBEDDED first and
; places the code itself.
;
; Memory. Every entry point maps RAM page KERNEL_RAM_PAGE (default 3, the calculator's spare
; page) into bank C through port 5 and keeps all its storage there, in two regions that TI-OS
; leaves alone: KERNEL_RAM_LOW, default $C500, $1200 bytes, and KERNEL_RAM_HIGH, default $DF00,
; $2000 bytes. Either may be defined as another multiple of $100 from $C000 up, provided its
; region ends at or below $10000, and the regions must not overlap. KERNEL_RAM_PAGE may be 2 to
; 7; pages 0 and 1 are TI-OS's own. ram.inc refuses any other value when the kernel is assembled.
; No other byte of the page is written, and no other page is.
;
; The caller cannot see that storage: its own bank C, including its stack, is swapped out for
; the length of a call. Nothing the caller needs lives there. Parameters go in through a block in
; memory outside bank C, and the one result that is not a status comes back in registers.
;
; Calling: DI, save and set port 5, switch to the kernel's own stack in the mapped page, map
; library pages at $8000 through port 7. On every exit, whatever the status, restore port 7,
; the caller's stack, port 5 and the interrupt state, in that order. Preserves IY and the shadow
; registers, destroys the rest. Between the port 5 write and the stack switch, and between the
; stack restore and the port 5 restore, no instruction uses the stack. Entry and exit together
; cost 374 T-states.
;
;   kernel_init     in:  HL = parameter block outside bank C: the library flash page (1 byte),
;                        then the four limits as 16-bit little-endian words: stack symbols,
;                        stack entries, saved symbols, saved entries. 9 bytes, copied before
;                        port 7 changes, so the block may be in bank B. HL above $BFF7, a block
;                        that touches bank C, is refused with Malformed before it is read.
;                   out: A = status
;   kernel_verify   in:  HL = assertion number, kernel_init returned 0
;                   out: A = status, 0 meaning accepted
;   kernel_crc_begin  in:  kernel_init returned 0
;                     out: A = status, 0 or Malformed
;   kernel_crc_chunk  in:  kernel_crc_begin returned 0
;                     out: A = ST_CRC_MORE until the last chunk, then 0 if the CRC-32 of the
;                          library bytes from offset 8 to its end equals the header's, else
;                          Malformed. With 0, DE:HL = the CRC-32, DE the high 16 bits and HL the
;                          low 16; with Malformed, DE:HL = 0; otherwise DE and HL are destroyed.
;
; kernel_verify returns Malformed unless the ready mark, which kernel_init sets when it succeeds
; and clears when it fails, is in place. The mark guards the init sequence, not the contents
; of the regions: the regions belong to the kernel between calls, and a caller that writes them
; gets undefined results. The mark can survive an app's exit, so every app session must call
; kernel_init before kernel_verify. Once it has, kernel_verify may be called any number of times.
; The library is stored the way TI-OS stores an app: chunk c of 16 KB at flash page KERNEL_LIB_PAGE - c.
; kernel_init refuses a library page >= $80 and a library that needs more than
; KERNEL_LIB_PAGE + 1 chunks; one that ends exactly at page 0 is accepted. The page is
; copied at init, so a later change to the caller's parameter block has no effect until the next
; kernel_init.
;
; The checksum runs in 16 KB steps so the app can poll keys between calls. kernel_crc_begin
; builds a 1 KB table (307,000 T-states at most, 51 ms at 6 MHz) and starts a run. Each
; kernel_crc_chunk reads the next chunk: at most 2,027,000 T-states from flash, 0.34 s at 6 MHz,
; 0.14 s at 15 MHz, about 124 T-states per byte. A library of 369,178 bytes takes 23 calls and
; 46.1 million T-states at most, 7.7 s at 6 MHz. Call chunk until it does not return
; ST_CRC_MORE. A chunk call without a begin since the last kernel_init, or after the run has
; ended, is refused (1); kernel_crc_begin restarts. The call that ends the run on a match
; returns the CRC-32 in DE:HL, which the app can key its status cache on.
;
; Symbols. kernel_init refuses with BadSymbol a name that is empty, has a byte outside $21 to $7E
; or a $, or equals another name, constants and variables together, once every Malformed rule has
; passed. The symbol table must end inside the first chunk. Labels are the host's check
; (mcpack::library::check): the kernel refers to assertions by index, so a repeated label changes
; nothing it proves.
;
; Records. A record is refused with BadRecord unless its float hypotheses all come before its
; essential ones and name distinct variables that an essential hypothesis or the conclusion uses.
;
; Reference list. The entries of a theorem's list appear in the order its proof first uses
; them, every entry is used, no two entries are equal, and no dummy entry names a variable the
; theorem has a float hypothesis for. A counter at kv_next ($B6, two bytes, in the private state)
; starts at 0 for each proof: a step naming entry k is a repeat use if k is below it, the first
; use if k equals it (it then rises by one), and LooseReference if k is above it; when the proof
; ends the counter must equal the entry count, else LooseReference.
; When several rules apply the first of these wins: Malformed, BadRecord from the record rules,
; BadRecord from a dummy entry for a variable with a float hypothesis, BadRecord from two equal
; entries or WorkLimit if the comparisons pass the limit first, then the proof's steps in order
; (a step above the counter is LooseReference before its entry is looked at, so a used forward
; reference is ForwardReference only when it is the next new entry), then at the end of the
; proof LooseReference for an unused entry, before NotSingleton and WrongConclusion.
;
; Work limit. Before the proof runs, the check on the reference list charges 1 per entry before
; it examines the entry for a dummy of a mandatory variable, then compares each entry with the
; ones after it and charges 1 per comparison before it is made, r * (r + 1) / 2 for r entries.
; A reference list longer than 511 entries cannot pass these checks within the work limit.
; The count is defined only after a call that returned ok: a list of up to 511 entries is charged
; in one step, so after a refusal the count may differ from the model's.
; The disjoint-variable check of a proof step takes the pairs of the applied
; assertion one at a time, with X and Y the expressions that replace its two variables, and
; charges every loop iteration before it runs, to the same count per kernel_verify call:
;   1 per pair of the applied assertion;
;   1 per symbol of X, constant or variable;
;   for each variable of X, 1 per symbol of Y;
;   for each variable of X against each variable of Y, 1 + n more, n being the number of pairs
;   (both lists) of the theorem being checked, whether or not the scan finds its match early.
; A charge that would take the count past WORK_LIMIT (ram.inc, equal to WORK_LIMIT in the model)
; ends the call with ST_WORK_LIMIT before that work is done; the assertion counts as refused.
; The slowest charged unit measured is 288 T-states (a variable against a run of constants), so
; one call spends at most 37.7 million T-states in the check, 6.3 s at 6 MHz.
;
; Interruption. kernel_verify reads the ON key (port 4, bit 3, clear while pressed) once per proof
; step and whenever the second byte of the work count changes. The read comes before the scan of
; the pair list that a comparison charges for, and the scan itself is not interrupted. The longest
; stretch without a read is one scan, 96 T-states per pair listed, plus up to 255 one-unit charges
; of 288 T-states before the second byte next changes. The reference list check on a list of up to
; 511 entries reads it before each row of at most 510 comparisons, 39 T-states each, after one
; pass over the entries of at most 511 steps of constant time; on a longer list every entry and
; every comparison is a one-unit charge. A record holds at most 7,750 pairs in this
; shape (about 8,000 fit a 16 KB page), so ON waits at most 0.83 million T-states, 0.14 s at
; 6 MHz; with 600 pairs, 130,000 T-states, 22 ms. With ON down kernel_verify returns
; ST_INTERRUPTED, restoring the stack, port 7 and the interrupt state as for any other exit and
; leaving the ready mark valid. The assertion has no verdict; call it again. The model never
; produces this status.
;
; kernel_init reads ON as well, once at the top of each outer iteration of its comparison of
; symbol names, and returns ST_INTERRUPTED with ON down. The ready mark is then clear, as when
; init never ran, so kernel_verify refuses with Malformed until a kernel_init succeeds; the
; caller treats the status as a stop and not as a damaged library. An outer iteration costs at
; most 0.91 million T-states (255 names of 62 bytes sharing 60, 0.15 s at 6 MHz), and ON held from
; the start stops init within 2.0 million, 0.33 s at 6 MHz, because the symbol loop and the byte
; checks before the comparison do not read it. That library takes 117.9 million T-states to
; initialise, 19.6 s at 6 MHz. The model's init is not interruptible.
;
; Status (ST_* in ram.inc)
;           0 ok               1 Malformed        2 BadRecord
;           3 NotATheorem (never returned)        4 ForwardReference
;           5 OutOfMemory      6 StackUnderflow   7 BadBackReference
;           8 TypecodeMismatch 9 HypothesisMismatch
;          10 DisjointViolation 11 StackNotSingleton 12 WrongConclusion
;          13 WorkLimit         14 Interrupted (kernel_verify, and kernel_init)
;          15 LooseReference  16 BadSymbol (kernel_init only)
;         255 ST_CRC_MORE (kernel_crc_chunk only)
;
; RAM, bank C of page KERNEL_RAM_PAGE, shown for the default bases:
;   low region $C500, $1200 bytes
;   $C500  $100  private state: parameters (9 bytes), saved SP, port 7, port 5 and interrupt
;                state, the two record descriptors, the CRC-32 run state
;   $C600  $100  typecode of each symbol id, $FF for a constant
;   $C700  $100  float marks of the record being checked
;   $C800  $100  kernel stack, growing down from $C900
;   $C900  $400  one bit per assertion: known to pass the record rules (ids below 8192)
;   $CD00  $200  stack entry starts, 256 entries
;   $CF00  $400  saved entry starts, 512 entries
;   $D300  $400  CRC-32 table, four planes of 256 bytes, built by kernel_crc_begin
;   high region $DF00, $2000 bytes
;   $DF00  $800  substitution, 8 bytes per variable: start, end, apply serial
;   $E700  $C00  stack symbols, scratch included
;   $F300  $C00  saved symbols
; Everything else on the page belongs to TI-OS.

#ifndef KERNEL_EMBEDDED
.org $4000
#endif

#include "ram.inc"

kernel_init:
	ld ix,init_body
	jr kernel_enter

kernel_verify:
	ld ix,verify_body

; in: IX = body, HL = the call's argument, left alone until the body runs. The window from the
; port 5 write to the stack switch, and the one from the stack restore to the port 5 restore in
; leave, hold no stack instruction: the caller's stack is in the page being swapped out.
kernel_enter:
	ld a,i
	jp pe,ke_on
	ld a,i
	jp pe,ke_on
	ld b,0
	jr ke_save
ke_on:
	ld b,1
ke_save:
	di
	in a,(5)
	ld c,a
	ld a,KERNEL_RAM_PAGE
ke_window:
	out (5),a
	ld a,b
	ld (kv_saved_iff),a
	ld a,c
	ld (kv_saved_port5),a
	ld (kv_saved_sp),sp
ke_window_end:
	ld sp,KSTACK_TOP
	in a,(7)
	ld (kv_saved_bank),a
	ld de,exit_ok
	push de
	jp (ix)

exit_ok:
	xor a
; in: A = status. DE and HL pass through to the caller.
leave:
	ld c,a
	ld a,(kv_saved_bank)
	out (7),a
	ld a,(kv_saved_iff)
	ld b,a
	ld a,(kv_saved_port5)
	ld sp,(kv_saved_sp)
leave_window:
	out (5),a
leave_window_end:
	ld a,b
	or a
	ld a,c
	ret z
	ei
	ret

fail_malformed:
	ld a,ST_MALFORMED
	jr leave
fail_bad_record:
	ld a,ST_BAD_RECORD
	jr leave
fail_forward:
	ld a,ST_FORWARD_REF
	jr leave
fail_oom:
	ld a,ST_OUT_OF_MEMORY
	jr leave
fail_underflow:
	ld a,ST_STACK_UNDERFLOW
	jr leave
fail_back:
	ld a,ST_BAD_BACK_REF
	jr leave
fail_typecode:
	ld a,ST_TYPECODE
	jr leave
fail_hyp_mismatch:
	ld a,ST_HYP_MISMATCH
	jr leave
fail_disjoint:
	ld a,ST_DISJOINT
	jr leave
fail_not_singleton:
	ld a,ST_NOT_SINGLETON
	jr leave
fail_wrong:
	ld a,ST_WRONG_CONCLUSION
	jr leave
fail_work_limit:
	ld a,ST_WORK_LIMIT
	jr leave
fail_interrupted:
	ld a,ST_INTERRUPTED
	jr leave
fail_loose:
	ld a,ST_LOOSE_REF
	jr leave
fail_bad_symbol:
	ld a,ST_BAD_SYMBOL
	jr leave

; in: HL = source, DE = destination, BC = count (may be 0)
; out: HL, DE advanced past the copy. Destroys AF BC.
copy_bc:
	ld a,b
	or c
	ret z
	ldir
	ret

; in: HL, DE = sources, BC = count (may be 0). out: Z if equal. Destroys AF BC DE HL.
mem_equal:
	ld a,b
	or c
	ret z
mem_equal_loop:
	ld a,(de)
	inc de
	cpi
	ret nz
	jp pe,mem_equal_loop
	ret

; in: HL += A. Destroys AF.
add_hl_a:
	add a,l
	ld l,a
	ret nc
	inc h
	ret

; in: HL, DE point at two little-endian 24-bit values a and b.
; out: C if a < b, Z if equal. Destroys AF BC DE HL.
cmp24:
	ld bc,2
	add hl,bc
	ex de,hl
	add hl,bc
	ex de,hl
	ld a,(hl)
	ex de,hl
	cp (hl)
	ex de,hl
	ret nz
	dec hl
	dec de
	ld a,(hl)
	ex de,hl
	cp (hl)
	ex de,hl
	ret nz
	dec hl
	dec de
	ld a,(hl)
	ex de,hl
	cp (hl)
	ret

#include "init.inc"
#include "record.inc"
#include "proof.inc"
#include "apply.inc"
#include "crc.inc"
