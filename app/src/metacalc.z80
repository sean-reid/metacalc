; The metacalc app. Three code pages (pages.inc) and, when built with a library, the library after
; them. This file is the entry page: the header, the shell and every call into the OS. Everything
; it needs from the canvas, fm, the kernel and the reader it reaches through a far entry.
;
; Start. far_init, the canvas font (fm_open needs it), then with LIBRARY: app_find_library,
; kernel_reset, lib_open on the library's chunk 0 and fm_open; the first status that is not 0 is kept
; in appStatus. Then scr_init opens the start screen.
; Loop. The shell runs the screen stack of scr/scr.z80: scr_draw, ui_blit, the sentinel, app_key, the
; sentinel check, scr_key, and then what scr_key returns. SCR_RES_IDLE waits for the next key with
; no draw and no blit, SCR_RES_REDRAW draws and blits, SCR_RES_LEAVE leaves, and SCR_RES_FAILED,
; with B the status of an enter that failed, pushes the error notice with scr_push_frame.
; 2nd+QUIT leaves from any depth before the stack sees it.
; Kinds, in screens.inc, screen_notice.inc and screen_about.inc, on this page:
;   1 start   with LIBRARY row 0 the title, row 1 the label of the library's first assertion, rows
;             2 to 6 its conclusion from fm_assertion and fm_draw, row 7 the hint; start_enter
;             builds the assertion, start_draw draws, and a refused call leaves everything under
;             the title out and shows its status as two hex digits on row 7 in place of the hint;
;             without, row 0 the title and row 3 the hint. F3 opens About, F1 and ENTER and F2 a
;             notice, CLEAR leaves.
;   2 notice  a title and a line; F1, CLEAR and ENTER go back
;   3 about   the version, two lines and the count of libraries; CLEAR and ENTER go back
; Sentinel. The OS writes the screen's pixels over saveSScreen when auto power down fires in
; _GetKey, which destroys what the top screen built in saveSScreen. After every blit the shell stores
; in APP_SENTINEL, a byte of saveSScreen's tail, the complement of the frame's byte at the same
; offset. A pixel copy over it makes the two bytes equal, which no complement is, so when
; app_key returns and the byte is not that complement, scr_refresh builds the top screen again
; before scr_key, and the screen is drawn again even when scr_key ignores the key. A refresh that
; fails is SCR_RES_FAILED.
; Failure. SCR_RES_FAILED pushes the error notice, and one that comes while the error notice is on
; top, from popping it or from refreshing it, leaves by app_exit, so a screen whose enter
; keeps failing cannot hold the user. When the push of the error notice fails the shell leaves too.
; Exit. CLEAR on the start screen, SCR_RES_LEAVE, and 2nd+QUIT leave through app_exit; 2nd+OFF is
; the OS's. Every way out runs app_putaway, which fills SCR_STACK with spaces and SCR_VARS with
; zeros, the state the home screen draws as blank, clears appRunning and appLaunched in iy+28h and
; onInterrupt, and sets graphDraw.
; start installs a context with _AppInit for that: the OS calls cxPPutAway and cxPutAway at 2nd+OFF
; and at _JForceCmdNoChar, and cxPPutAway alone when an OS call raises an error. On that error
; screen 1:Quit returns to the home screen through the OS and 2:Goto through cxErrorEP, which
; leaves by app_exit. An auto power down calls none of them.
; RAM: the canvas's, fm's and the kernel's blocks in ram_map.inc, libPage (the flash page of
; library chunk 0) and appStatus after it, and APP_BUF, which holds the reader's scratch and the
; strings in glyph codes, APP_FRAME in its upper half. The strings the canvas reads from the draw
; page are in strings.inc.

#include "equates.inc"

#define APP_NAME "metacalc"
#include "pages.inc"
#include "header.inc"
	jp app_start
#include "farcall.inc"
far_table .equ $
#define FAR_STUBS
#include "far_reader.inc"
#undef FAR_STUBS
far_table_end .equ $
#include "far_draw.inc"
#include "far_kernel.inc"
#include "libpage.inc"

#define SCR_EMBEDDED
#include "scr/scr.z80"

HINT_ROW = 3
HINT_COL = 1
LABEL_ROW = 1
FORMULA_ROW = 2
FORMULA_END = 7
LIBRARY_HINT_ROW = 7
FORMULA_X = 3
FORMULA_WIDTH = 92

app_start:
	ld hl, app_vectors
	bcall(_AppInit)
	call far_init
	ld hl, ui_font
	call far_ui_set_font
	xor a
	ld (appStatus), a
#ifdef LIBRARY
	call app_find_library
	call far_kernel_reset
	ld a, (libPage)
	ld de, APP_BUF
	call far_lib_open
	ld (appStatus), a
	or a
	jr nz, app_open
	call far_fm_open
	ld (appStatus), a
#endif
app_open:
	ld hl, screen_kinds
	ld de, screen_first
	call scr_init
app_draw:
	call scr_draw
	call far_ui_blit
	call app_arm
app_wait:
	call app_key
	cp KEY_QUIT
	jr z, app_exit
	ld c, a
	push bc
	ld a, (APP_SENTINEL_FRAME)
	cpl
	ld hl, APP_SENTINEL
	cp (hl)
	ld d, 0
	jr z, app_keyed
	call scr_refresh
	or a
	jr nz, app_refresh_failed
	ld d, 1
app_keyed:
	pop bc
	call app_error_open
	ld e, a
	push de
	ld a, c
	call scr_key
	pop de
	or a
	jr nz, app_result
	ld a, d
	or a
	jr z, app_wait
	jr app_draw
app_result:
	cp SCR_RES_REDRAW
	jr z, app_draw
	cp SCR_RES_LEAVE
	jr z, app_exit
	ld a, e
	or a
	jr nz, app_exit
app_failed:
	ld a, KIND_NOTICE
	ld c, b
	ld b, NOTICE_ERROR
	ld hl, APP_FRAME
	call screen_make
	call scr_push_frame
	cp SCR_RES_REDRAW
	jr z, app_draw
app_exit:
	di
	call app_putaway
	bjump(_JForceCmdNoChar)

app_refresh_failed:
	pop bc
	ld b, a
	call app_error_open
	or a
	jr nz, app_exit
	jr app_failed

; Out: A = 1 when the top screen is the error notice, else 0. Destroys HL.
app_error_open:
	call scr_top
	ld a, (hl)
	cp KIND_NOTICE
	jr nz, app_error_closed
	inc hl
	ld a, (hl)
	cp NOTICE_ERROR
	ld a, 1
	ret z
app_error_closed:
	xor a
	ret

; Stores the complement of the frame's byte at APP_SENTINEL_FRAME in APP_SENTINEL.
app_arm:
	ld a, (APP_SENTINEL_FRAME)
	cpl
	ld (APP_SENTINEL), a
	ret

; Puts the home screen's RAM back as the header says. The OS calls it with iy at the flags.
app_putaway:
	ld hl, SCR_STACK
	ld de, SCR_STACK + 1
	ld bc, SCR_STACK_SIZE - 1
	ld (hl), ' '
	ldir
	ld hl, SCR_VARS
	ld de, SCR_VARS + 1
	ld bc, SCR_VARS_SIZE - 1
	ld (hl), 0
	ldir
	res appRunning, (iy + APIFlg)
	res appLaunched, (iy + APIFlg)
	res onInterrupt, (iy + onFlags)
	set graphDraw, (iy + graphFlags)
	ret

; The context the OS keeps for the app: cxMain, cxPPutAway, cxPutAway, cxRedisp, cxErrorEP,
; cxSizeWind and the flag byte. cxRedisp and cxSizeWind return to the OS at once. cxErrorEP leaves
; through app_exit: with a bare ret the error screen's 2:Goto leaves the OS idle in this context.
app_vectors:
	.dw app_exit, app_putaway, app_putaway, app_ret, app_exit, app_ret
	.db 0

app_ret:
	ret

#include "text.inc"
#include "screens.inc"
#include "screen_notice.inc"
#include "screen_about.inc"

#define KEYS_SET_FONT far_ui_set_font
#include "keys.inc"

	APP_PAGE_FILL(PAGE_ENTRY)
#include "page_draw.inc"
#include "page_data.inc"

#ifdef LIBRARY
.fill 8000h - $, 0
#include "library.inc"
#endif
