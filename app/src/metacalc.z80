#include "equates.inc"

#define APP_NAME "metacalc"
#include "header.inc"

start:
#ifdef LIBRARY
	call app_find_library
#endif
	bcall(_ClrLCDFull)
	xor a
	ld (curRow), a
	ld (curCol), a
	ld hl, title
print:
	ld a, (hl)
	or a
	jr z, done
	bcall(_PutC)
	inc hl
	jr print
done:
	bcall(_GetKey)
	bjump(_JForceCmdNoChar)

title:
	.db "metacalc", 0

#ifdef LIBRARY
#include "libpage.inc"
.fill 8000h - $, 0
#include "library.inc"
#endif
