; The metacalc app. Three code pages (pages.inc) and, when built with a library, the library after
; them. This file is the entry page: the header, the shell and every call into the OS. Everything
; it needs from the canvas, fm, the kernel and the reader it reaches through a far entry.
;
; Start. far_init, the canvas font (fm_open needs it), then with LIBRARY: app_find_library,
; kernel_reset, lib_open on the library's chunk 0 and fm_open; the first status that is not 0 is kept
; in appStatus. Then scr_init opens the Libraries screen, and an enter that fails there, which a
; refused library does, pushes the error notice over it.
; Loop. The shell runs the screen stack of scr/scr.z80. After every frame (scr_draw, ui_blit, the
; sentinel) and after every key the stack answered SCR_RES_IDLE to with no refresh, it goes
; through the idle point, and then blocks in app_key. The idle point asks app_key_waiting. A scan
; code goes to app_key. With no scan code, a key down on the port goes to app_key when APP_HELD is
; 0, since it is a press the OS has not scanned yet; when APP_HELD is not 0 it counts as no key
; and sets APP_HELD to 2. APP_HELD, "the key I handled may still be down", is a count: 2 from the
; start, since the key that launched the app may still be down, and after every app_key. It goes
; down by one, to 0 at the least, at each idle point where app_key_waiting answers Z. So a key
; that only the port shows is a new press after two idle points in a row with every key up, and a
; contact that reads down again right after a release is not. That rests on idle points being
; about a tick apart, 9.3 ms, while a screen waits on app_tick. With no key waiting the shell asks
; app_error_open and calls scr_idle, which does the top screen's pending work: SCR_RES_REDRAW
; draws and blits, SCR_RES_LEAVE and SCR_RES_FAILED are handled as scr_key's are below, and
; SCR_RES_IDLE goes back to the idle point while the carry says more work is pending and to
; app_key when it is clear. A key is looked for between every two idle calls, and a screen with
; nothing pending costs one app_key_waiting and one scr_idle for each frame or key, and leaves key
; repeat and auto power down to app_key. After app_key the shell runs the sentinel check, scr_key,
; and then what scr_key returns: SCR_RES_IDLE goes to the idle point with no draw and no blit,
; SCR_RES_REDRAW draws and blits, SCR_RES_LEAVE leaves, and SCR_RES_FAILED, with B the status of
; an enter that failed, pushes the error notice with scr_push_frame. 2nd+QUIT leaves from any
; depth before the stack sees it.
; Interrupts. app_key_waiting needs them on at its call. The first frame comes to the idle point
; with them off, as the app is entered, so the shell turns them on after every frame's arm; every
; other way in has them on, since app_key returns with them on and the framework, the screens and the
; blit leave them as they found them. A kind's idle routine returns with them on, also when it ran
; its slice with them off. A tap that starts and ends inside one slice that runs with them off is
; never scanned and is lost. A key still down at the end of such a slice is taken at once while
; APP_HELD is 0, as a press the OS has not scanned. While APP_HELD is not 0 it is taken through its
; scan code at a later idle point: the OS sets no scan code for a second key while the first is
; held, so the press is taken at the end of the slice running when the first key goes up.
; Sentinel and work. Idle work runs before the sentinel check of the next key; the OS writes over
; saveSScreen only when auto power down fires inside _GetKey, so no idle call sees it overwritten.
; ON is ignored while work is pending: with no scan code and onInterrupt set or ON down, the shell
; clears onInterrupt and goes on to scr_idle, leaving APP_HELD as it is. The one case where ON
; does not go on to scr_idle is no scan code, ON and a key both down and APP_HELD 0, which goes to
; app_key by the key's rule. When scr_idle answers carry clear while ON is still down, the OS has
; flagged that press once and the shell has cleared the flag, so app_key waits in _GetKey with ON
; down, where a screen with nothing pending is in app_key's wait for ON to go up; once ON is up
; the OS state is the same in both. A pending 2nd or ALPHA is a scan code, so it sends the shell
; to app_key and the work waits for the key after it.
; Kinds, in screens.inc and the files it names, on this page:
;   1 libraries   one row for each stage of the library and then My proofs, with each stage's
;                 progress read from the status table (screen_libraries.inc, screen_counts.inc);
;                 F3 opens About, or the stage's About when there is more than one stage, F1 and
;                 ENTER and F2 a notice, CLEAR leaves
;   2 notice      a title and a line; F1, CLEAR and ENTER go back
;   3 about       the version, two lines and the count of libraries; CLEAR and ENTER go back
;   4 stage       a stage's name, title and counts (screen_stage.inc); CLEAR and ENTER go back
; Stages. With LIBRARY the build's stage table (stages.inc, from app/Makefile) says what the rows
; are; STAGE_COUNT is 0 without one. The table is on this page, so the screens that draw it copy
; the strings they need to APP_TEXT. The status table store (store.inc) is linked in on this page,
; since it makes OS calls, and only Libraries and the stage About read it: libs_counts asks
; store_has and never opens a table, so the screens never create one. The store destroys OP1 to
; OP5 and needs IY, the OS flags pointer.
; Sentinel. The OS writes the screen's pixels over saveSScreen when auto power down fires in
; _GetKey, which destroys what the top screen built in saveSScreen. After every blit the shell stores
; in APP_SENTINEL, a byte of saveSScreen's tail, the complement of the frame's byte at the same
; offset. A pixel copy over it makes the two bytes equal, which no complement is, so when
; app_key returns and the byte is not that complement, scr_refresh builds the top screen again
; before scr_key, and the screen is drawn again even when scr_key ignores the key. A refresh that
; fails is SCR_RES_FAILED.
; Failure. SCR_RES_FAILED pushes the error notice, and one that comes while the error notice is on
; top, from popping it or from refreshing it, leaves by app_exit, so a screen whose enter
; keeps failing cannot hold the user. When the push of the error notice fails the shell leaves too.
; Exit. CLEAR on the Libraries screen, SCR_RES_LEAVE, and 2nd+QUIT leave through app_exit; 2nd+OFF is
; the OS's. Every way out runs app_putaway, which fills SCR_STACK with spaces and SCR_VARS with
; zeros, the state the home screen draws as blank, zeroes cmdShadCur, the copy the home screen
; restores the cursor from, while editCursor equals editTop, that is while no entry text is pending
; (cmdCursor is the cursor's offset in the entry, not its length), clears appRunning and
; appLaunched in iy+28h and onInterrupt, and sets graphDraw. It never writes the entry line's
; buffer. app_exit then hands the OS a CLEAR key with _JForceCmd, which empties an unentered entry
; the way a key press does; 2nd+OFF and 1:Quit leave one as it was, with the screen blank.
; start installs a context with _AppInit for that: the OS calls cxPPutAway and cxPutAway at 2nd+OFF
; and at _JForceCmd, and cxPPutAway alone when an OS call raises an error. On that error
; screen 1:Quit returns to the home screen through the OS and 2:Goto through cxErrorEP, which
; leaves by app_exit. An auto power down calls none of them.
; RAM: the canvas's, fm's and the kernel's blocks in ram_map.inc, libPage (the flash page of
; library chunk 0) and appStatus after it, and APP_BUF, which holds what the top screen's enter
; and draw build: the counts, the strings in glyph codes and the error notice's frame, laid out in
; ram_map.inc. APP_HELD, one byte in APP_BUF, is the shell's and no screen builds it again; an auto
; power down's overwrite of it happens only inside _GetKey and the shell sets it after every
; app_key, so the overwritten value is never read. APP_STAGE follows APP_BUF, which holds the copy
; of the constant strings (strings.inc) of the screen last drawn, since the canvas cannot read the
; entry page. The tag at its start is cleared at start and before the refresh that follows an auto
; power down.

#include "equates.inc"

#define APP_NAME "metacalc"
#include "pages.inc"
#include "header.inc"
	jp app_start
#include "farcall.inc"
far_table .equ $
#define FAR_STUBS
#include "far_reader.inc"
#undef FAR_STUBS
far_table_end .equ $
#include "far_draw.inc"
#include "far_kernel.inc"
#include "libpage.inc"

#define SCR_EMBEDDED
#include "scr/scr.z80"

app_start:
	ld hl, app_vectors
	bcall(_AppInit)
	call far_init
	ld hl, ui_font
	call far_ui_set_font
	xor a
	ld (appStatus), a
	ld h, a
	ld l, a
	ld (APP_STAGE_TAG), hl
#ifdef LIBRARY
	call app_find_library
	call far_kernel_reset
	ld a, (libPage)
	ld de, APP_BUF
	call far_lib_open
	ld (appStatus), a
	or a
	jr nz, app_open
	call far_fm_open
	ld (appStatus), a
#endif
app_open:
	ld a, 2
	ld (APP_HELD), a
	ld hl, screen_kinds
	ld de, screen_first
	call scr_init
	or a
	jr z, app_draw
	ld b, a
	jp app_failed
app_draw:
	call scr_draw
	call far_ui_blit
	call app_arm
	ei
app_idle:
	call app_key_waiting
	ld hl, APP_HELD
	jr z, app_none
	jr nc, app_wait
	bit 0, a
	jr z, app_on
	ld a, (hl)
	or a
	jr z, app_wait
	ld (hl), 2
app_on:
	res onInterrupt, (iy + onFlags)
	jr app_work
app_none:
	ld a, (hl)
	or a
	jr z, app_work
	dec (hl)
app_work:
	call app_error_open
	ld e, a
	push de
	call scr_idle
	pop de
	jr nc, app_idled
	or a
	jr nz, app_result
	jr app_idle
app_idled:
	or a
	jr nz, app_result
app_wait:
	call app_key
	ld hl, APP_HELD
	ld (hl), 2
	cp KEY_QUIT
	jr z, app_exit
	ld c, a
	push bc
	ld a, (APP_SENTINEL_FRAME)
	cpl
	ld hl, APP_SENTINEL
	cp (hl)
	ld d, 0
	jr z, app_keyed
	ld hl, 0
	ld (APP_STAGE_TAG), hl
	call scr_refresh
	or a
	jr nz, app_refresh_failed
	ld d, 1
app_keyed:
	pop bc
	call app_error_open
	ld e, a
	push de
	ld a, c
	call scr_key
	pop de
	or a
	jr nz, app_result
	ld a, d
	or a
	jr z, app_idle
	jr app_draw
app_result:
	cp SCR_RES_REDRAW
	jr z, app_draw
	cp SCR_RES_LEAVE
	jr z, app_exit
	ld a, e
	or a
	jr nz, app_exit
app_failed:
	ld a, KIND_NOTICE
	ld c, b
	ld b, NOTICE_ERROR
	ld hl, APP_FRAME
	call screen_make
	call scr_push_frame
	cp SCR_RES_REDRAW
	jp z, app_draw
app_exit:
	di
	call app_putaway
	ld a, kClear
	bjump(_JForceCmd)

app_refresh_failed:
	pop bc
	ld b, a
	call app_error_open
	or a
	jr nz, app_exit
	jr app_failed

; Out: A = 1 when the top screen is the error notice, else 0. Destroys HL.
app_error_open:
	call scr_top
	ld a, (hl)
	cp KIND_NOTICE
	jr nz, app_error_closed
	inc hl
	ld a, (hl)
	cp NOTICE_ERROR
	ld a, 1
	ret z
app_error_closed:
	xor a
	ret

; Stores the complement of the frame's byte at APP_SENTINEL_FRAME in APP_SENTINEL.
app_arm:
	ld a, (APP_SENTINEL_FRAME)
	cpl
	ld (APP_SENTINEL), a
	ret

; Puts the home screen's RAM back as the header says. The OS calls it with iy at the flags.
app_putaway:
	ld hl, SCR_STACK
	ld de, SCR_STACK + 1
	ld bc, SCR_STACK_SIZE - 1
	ld (hl), ' '
	ldir
	ld hl, SCR_VARS
	ld de, SCR_VARS + 1
	ld bc, SCR_VARS_SIZE - 1
	ld (hl), 0
	ldir
	ld hl, (editTop)
	ld de, (editCursor)
	or a
	sbc hl, de
	jr nz, app_putaway_flags
	ld (cmdShadCur), hl
app_putaway_flags:
	res appRunning, (iy + APIFlg)
	res appLaunched, (iy + APIFlg)
	res onInterrupt, (iy + onFlags)
	set graphDraw, (iy + graphFlags)
	ret

; The context the OS keeps for the app: cxMain, cxPPutAway, cxPutAway, cxRedisp, cxErrorEP,
; cxSizeWind and the flag byte. cxRedisp and cxSizeWind return to the OS at once. cxErrorEP leaves
; through app_exit: with a bare ret the error screen's 2:Goto leaves the OS idle in this context.
app_vectors:
	.dw app_exit, app_putaway, app_putaway, app_ret, app_exit, app_ret
	.db 0

app_ret:
	ret

#include "text.inc"
#include "strings.inc"
#ifdef LIBRARY
#include "stages.inc"
#else
STAGE_COUNT .equ 0
#endif
#include "screens.inc"
#ifdef LIBRARY
#include "screen_counts.inc"
#endif
#include "screen_libraries.inc"
#include "screen_notice.inc"
#include "screen_about.inc"
#include "screen_stage.inc"
#ifdef LIBRARY
#include "store.inc"
#endif

#define KEYS_SET_FONT far_ui_set_font
#include "keys.inc"

	APP_PAGE_FILL(PAGE_ENTRY)
#include "page_draw.inc"
#include "page_data.inc"

#ifdef LIBRARY
.fill 8000h - $, 0
#include "library.inc"
#endif
