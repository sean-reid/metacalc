; The metacalc app. Three code pages (pages.inc) and, when built with a library, the library after
; them. This file is the entry page: the header, the shell and every call into the OS. Everything
; it needs from the canvas, fm, the kernel and the reader it reaches through a far entry.
;
; The start screen is the canvas's, drawn from the strings on the draw page. app_key redraws it
; after every key but CLEAR and QUIT, which leave. RAM: the canvas's, fm's and the kernel's blocks
; in ram_map.inc, and libPage, the flash page of the library's chunk 0, when built with LIBRARY.

#include "equates.inc"

#define APP_NAME "metacalc"
#include "pages.inc"
#include "header.inc"
	jp app_start
#include "farcall.inc"
far_table .equ $
#define FAR_STUBS
#include "far_reader.inc"
#undef FAR_STUBS
far_table_end .equ $
#include "far_draw.inc"
#include "far_kernel.inc"
#include "libpage.inc"

app_start:
	call far_init
#ifdef LIBRARY
	call app_find_library
#endif
	ld hl, ui_font
	call far_ui_set_font
app_screen:
	call far_ui_clear
	ld hl, str_title
	ld de, str_none
	call far_ui_title
	ld hl, str_hint
	ld de, HINT_COL
	ld b, HINT_ROW
	call far_ui_text
	call far_ui_blit
	call app_key
	cp KEY_CLEAR
	jr z, app_exit
	cp KEY_QUIT
	jr z, app_exit
	jr app_screen
app_exit:
	di
	res onInterrupt, (iy + onFlags)
	set graphDraw, (iy + graphFlags)
	bjump(_JForceCmdNoChar)

HINT_ROW = 3
HINT_COL = 1

#define KEYS_SET_FONT far_ui_set_font
#include "keys.inc"

	APP_PAGE_FILL(PAGE_ENTRY)
#include "page_draw.inc"
#include "page_data.inc"

#ifdef LIBRARY
.fill 8000h - $, 0
#include "library.inc"
#endif
