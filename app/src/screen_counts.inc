; The stage table and the check counts it needs, for the Libraries screen and the stage About
; screen. Only a build with LIBRARY has them: stages.inc (generated by scripts/stages-include.sh)
; holds the table, and STAGE_COUNT, a number from 1 to 6, is the number of stages.
;
; libs_list    out: A = 0, or the status of the reader call that refused (Z set as A). Builds APP_LIST, the
;              list store_count_ends takes, from the table: with STAGES_FROM_LIBRARY the one end is the
;              library's assertion count, which HL holds on a 0. Writes APP_LIST and the reader's own
;              state (LIB_STATE, FAR_VARS) with STAGES_FROM_LIBRARY, never the store's. Destroys BC, DE, HL.
; libs_counts  out: A = 0, or the status of a reader call that refused. Zeroes APP_COUNTS, builds APP_LIST
;              with libs_list and asks the store (store_has) for a table with the library's CRC and
;              count. When there is one, a single store_count_ends pass over the ends fills APP_COUNTS,
;              eight bytes for each stage, the words n0 to n3 of store.inc. When there is none, because
;              it is absent, archived, another library's or damaged, or when that pass fails, every
;              stage stays unchecked, since a pass that fails writes no result, and A is 0: a damaged
;              table is the check job's to replace. Nothing is created, since nothing here calls
;              store_open. Destroys OP1 to OP5, which nothing else in the shell holds across it.
; libs_figures in: A = a stage. out: HL = its assertions, DE = those checked (n1 + n3 of the
;              store), BC = those failed (n2). Destroys AF and IX.
; stage_strings in: A = a stage. out: HL = its name, DE = its title, glyph codes ended by 0 in the
;              stage table, which the canvas cannot read. Destroys AF.

#if (8 * STAGE_COUNT) > APP_COUNTS_SIZE
 .error "APP_COUNTS holds the counts of 6 stages"
#endif

libs_counts:
	ld hl, APP_COUNTS
	ld de, APP_COUNTS + 1
	ld bc, APP_COUNTS_SIZE - 1
	ld (hl), 0
	ldir
	call libs_list
	ret nz
#ifndef STAGES_FROM_LIBRARY
	call far_lib_assertion_count
	ret nz
#endif
	push hl
	ld bc, 4
	ld de, APP_CRC
	ld hl, 4
	xor a
	call far_lib_read
	pop bc
	or a
	ret nz
	ld hl, (APP_CRC)
	ld de, (APP_CRC + 2)
	call store_has
	or a
	jr nz, libs_untabled
	ld hl, APP_LIST
	ld de, APP_COUNTS
	call store_count_ends
libs_untabled:
	xor a
	ret

libs_list:
	ld hl, stage_list
	ld de, APP_LIST
	ld bc, 1 + (2 * STAGE_COUNT)
	ldir
#ifdef STAGES_FROM_LIBRARY
	call far_lib_assertion_count
	ret nz
	ld (APP_LIST + 1), hl
#else
	xor a
#endif
	ret

libs_figures:
	ld c, a
	ld b, 0
	ld hl, APP_LIST + 1
	add hl, bc
	add hl, bc
	ld e, (hl)
	inc hl
	ld d, (hl)
	push de
	ld a, c
	add a, a
	add a, a
	add a, a
	ld c, a
	ld hl, APP_COUNTS
	add hl, bc
	push hl
	pop ix
	ld c, (ix + 4)
	ld b, (ix + 5)
	ld e, (ix + 2)
	ld d, (ix + 3)
	ld a, (ix + 6)
	add a, e
	ld e, a
	ld a, (ix + 7)
	adc a, d
	ld d, a
	pop hl
	ret

stage_strings:
	add a, a
	add a, a
	ld l, a
	ld h, 0
	ld de, stage_text
	add hl, de
	ld e, (hl)
	inc hl
	ld d, (hl)
	inc hl
	push de
	ld e, (hl)
	inc hl
	ld d, (hl)
	pop hl
	ret
